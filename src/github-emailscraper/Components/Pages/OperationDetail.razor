@page "/operations/{Id:guid}"
@implements IDisposable
@inject OperationManager Manager

<PageTitle>@(_op?.Name ?? "Operation") — GitHub Email Scraper</PageTitle>

@if (_op is null)
{
    <div class="alert alert-warning">Operation not found. <a href="/">Go to dashboard</a></div>
    return;
}

<!-- Header -->
<div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
    <a href="/" class="btn btn-sm btn-outline-secondary flex-shrink-0">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="h3 mb-0 flex-grow-1">@_op.Name</h1>
    <span class="badge fs-6 @StatusClass(_op.Status)">@_op.Status</span>

    @if (_op.Status == OperationStatus.Running)
    {
        <button class="btn btn-warning" @onclick="Stop">
            <i class="bi bi-stop-fill me-1"></i>Stop
        </button>
    }
    else
    {
        <button class="btn btn-success" @onclick="Start">
            <i class="bi bi-play-fill me-1"></i>
            @(_op.Status is OperationStatus.Completed or OperationStatus.Cancelled or OperationStatus.Failed
                ? "Re-run" : "Start")
        </button>
    }
</div>

<!-- Live progress banner -->
@if (_op.Status == OperationStatus.Running)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
        <span class="spinner-border spinner-border-sm flex-shrink-0"></span>
        <div>
            <strong>Running</strong>
            @if (!string.IsNullOrEmpty(_op.CurrentUser))
            {
                <span class="ms-2">— scanning <strong>@_op.CurrentUser</strong></span>
            }
            @if (!string.IsNullOrEmpty(_op.CurrentQuery))
            {
                <span class="text-muted ms-2 small">(@_op.CurrentQuery)</span>
            }
        </div>
    </div>
}

<!-- Stats cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-3">
                <div class="display-6 fw-bold text-success">@_op.EmailsFound</div>
                <div class="text-muted small text-uppercase">Emails Found</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-3">
                <div class="display-6 fw-bold">@_op.ProfilesScanned</div>
                <div class="text-muted small text-uppercase">Profiles Scanned</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-3">
                <div class="display-6 fw-bold text-danger">@_op.Failures</div>
                <div class="text-muted small text-uppercase">Failures</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters summary -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold border-bottom">
        <i class="bi bi-funnel me-2"></i>Filters
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Keywords</dt>
            <dd class="col-sm-9">
                @if (_op.Filters.Keywords.Any())
                {
                    @foreach (var kw in _op.Filters.Keywords)
                    { <span class="badge bg-primary me-1 mb-1">@kw</span> }
                }
                else { <span class="text-muted">—</span> }
            </dd>
            <dt class="col-sm-3">Locations</dt>
            <dd class="col-sm-9">
                @if (_op.Filters.Locations.Any())
                {
                    @foreach (var loc in _op.Filters.Locations)
                    { <span class="badge bg-info text-dark me-1 mb-1">@loc</span> }
                }
                else { <span class="text-muted">—</span> }
            </dd>
            <dt class="col-sm-3">Min Followers</dt>
            <dd class="col-sm-9">@_op.Filters.MinFollowers</dd>
            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@_op.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
            @if (_op.CompletedAt.HasValue)
            {
                <dt class="col-sm-3">Completed</dt>
                <dd class="col-sm-9">@_op.CompletedAt.Value.ToString("yyyy-MM-dd HH:mm") UTC</dd>
            }
        </dl>
    </div>
</div>

<!-- Results table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between">
        <span class="fw-semibold">
            <i class="bi bi-table me-2"></i>Results
            <span class="badge bg-secondary ms-1">@_results.Count</span>
        </span>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadResults">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
            @if (File.Exists(_op.CsvPath))
            {
                <a href="/api/operations/@_op.Id/download" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-download me-1"></i>Download CSV
                </a>
            }
        </div>
    </div>

    @if (_results.Any())
    {
        <div class="table-responsive" style="max-height:520px;overflow-y:auto;">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light sticky-top">
                    <tr>
                        <th>Username</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Location</th>
                        <th class="text-end">Followers</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _results)
                    {
                        <tr>
                            <td>
                                <a href="https://github.com/@r.Username" target="_blank"
                                   class="text-decoration-none fw-semibold">
                                    @r.Username
                                </a>
                            </td>
                            <td>@r.Name</td>
                            <td><a href="mailto:@r.Email" class="text-decoration-none">@r.Email</a></td>
                            <td>@r.Location</td>
                            <td class="text-end text-muted">@r.Followers</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox display-5 d-block mb-2 text-secondary"></i>
            @if (_op.Status == OperationStatus.Running)
            {
                <p>Scraping in progress — results will appear here as they are found.</p>
            }
            else if (_op.Status == OperationStatus.Idle)
            {
                <p>Start the operation to begin scraping.</p>
            }
            else
            {
                <p>No emails were found for this operation.</p>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private ScrapingOperation?             _op      = null;
    private IReadOnlyList<DeveloperRecord> _results = Array.Empty<DeveloperRecord>();
    private System.Threading.Timer?        _timer;

    protected override void OnInitialized()
    {
        _op = Manager.Get(Id);
        LoadResults();
        Manager.StateChanged += OnStateChanged;
        _timer = new System.Threading.Timer(_ => InvokeAsync(Refresh), null, 2000, 2000);
    }

    private void OnStateChanged() => InvokeAsync(Refresh);

    private void Refresh()
    {
        _op = Manager.Get(Id);
        if (_op?.Status == OperationStatus.Running)
            LoadResults();
        StateHasChanged();
    }

    private void LoadResults() => _results = Manager.GetResults(Id);

    private void Start() { Manager.Start(Id); Refresh(); }
    private void Stop()  { Manager.Stop(Id);  Refresh(); }

    private static string StatusClass(OperationStatus s) => s switch
    {
        OperationStatus.Running   => "bg-success",
        OperationStatus.Completed => "bg-primary",
        OperationStatus.Failed    => "bg-danger",
        OperationStatus.Cancelled => "bg-warning text-dark",
        _                         => "bg-secondary"
    };

    public void Dispose()
    {
        Manager.StateChanged -= OnStateChanged;
        _timer?.Dispose();
    }
}
