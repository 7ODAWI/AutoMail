<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — GitHubScraper</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="d-flex" id="app-wrapper">

        <!-- Sidebar -->
        <nav id="sidebar">
            <div class="sidebar-brand">
                <i class="bi bi-github me-2"></i>GitHubScraper
            </div>
            <ul class="sidebar-nav">
                <li>
                    <a asp-controller="Operations" asp-action="Index"
                       class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="bi bi-grid-3x3-gap me-2"></i>Dashboard
                    </a>
                </li>
                <li>
                    <a asp-controller="Operations" asp-action="Create"
                       class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")">
                        <i class="bi bi-plus-circle me-2"></i>New Operation
                    </a>
                </li>
            </ul>
            <div class="sidebar-footer">
                <small class="text-muted">v1.0 · .NET 8</small>
            </div>
        </nav>

        <!-- Main content -->
        <main id="main-content" class="flex-grow-1">
            <div class="container-fluid p-4">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/operations.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
