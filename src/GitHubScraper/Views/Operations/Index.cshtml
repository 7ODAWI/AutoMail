@model GitHubScraper.ViewModels.Operations.OperationListViewModel
@using GitHubScraper.Models.Enums
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-grid-3x3-gap me-2 text-primary"></i>Operations Dashboard</h4>
    <div class="d-flex gap-2">
        <form asp-action="StartAll" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-primary"
                    onclick="return confirmAction('Start all non-running operations?', this.form)">
                <i class="bi bi-play-circle me-1"></i>Start All Operations
            </button>
        </form>
        <a asp-action="ExportAllDistinct" class="btn btn-outline-success">
            <i class="bi bi-download me-1"></i>Export All CSV (Distinct)
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>New Operation
        </a>
    </div>
</div>

@if (!Model.Operations.Any())
{
    <div class="empty-state text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <h5 class="mt-3 text-muted">No operations yet</h5>
        <p class="text-muted">Create your first scraping operation to start collecting GitHub emails.</p>
        <a asp-action="Create" class="btn btn-primary mt-2">
            <i class="bi bi-plus-circle me-1"></i>Create Operation
        </a>
    </div>
}
else
{
    <div class="row g-4" id="operations-grid">
        @foreach (var op in Model.Operations)
        {
            <div class="col-xl-4 col-lg-6" id="op-card-@op.Id">
                <div class="card op-card h-100">
                    <div class="card-header d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="mb-1 fw-bold text-truncate" style="max-width:180px" title="@op.Name">
                                @op.Name
                            </h6>
                            <small class="text-muted">@op.CreatedAt.ToLocalTime().ToString("MMM d, yyyy HH:mm")</small>
                        </div>
                        <span class="badge status-badge status-@op.Status.ToString().ToLower()" id="badge-@op.Id">
                            @if (op.Status == OperationStatus.Running)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            @op.Status
                        </span>
                    </div>
                    <div class="card-body">
                        <!-- Stats row -->
                        <div class="row g-2 text-center mb-3">
                            <div class="col-4">
                                <div class="stat-mini">
                                    <div class="stat-mini-value text-success" id="emails-@op.Id">@op.EmailsFound</div>
                                    <div class="stat-mini-label">Emails</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-mini">
                                    <div class="stat-mini-value text-primary" id="profiles-@op.Id">@op.ProfilesScanned</div>
                                    <div class="stat-mini-label">Scanned</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-mini">
                                    <div class="stat-mini-value text-danger" id="failures-@op.Id">@op.Failures</div>
                                    <div class="stat-mini-label">Failures</div>
                                </div>
                            </div>
                        </div>

                        <!-- Filters -->
                        <div class="mb-2">
                            @if (op.Keywords.Any())
                            {
                                <div class="filter-tags mb-1">
                                    @foreach (var kw in op.Keywords.Take(3))
                                    {
                                        <span class="badge bg-light text-dark border me-1">@kw</span>
                                    }
                                    @if (op.Keywords.Count > 3)
                                    {
                                        <span class="badge bg-secondary">+@(op.Keywords.Count - 3)</span>
                                    }
                                </div>
                            }
                            @if (op.Locations.Any())
                            {
                                <div class="filter-tags">
                                    <i class="bi bi-geo-alt text-muted small me-1"></i>
                                    @foreach (var loc in op.Locations.Take(2))
                                    {
                                        <span class="badge bg-light text-dark border me-1">@loc</span>
                                    }
                                    @if (op.Locations.Count > 2)
                                    {
                                        <span class="badge bg-secondary">+@(op.Locations.Count - 2)</span>
                                    }
                                </div>
                            }
                        </div>

                        @if (op.Status == OperationStatus.Running && !string.IsNullOrEmpty(op.CurrentUser))
                        {
                            <div class="text-muted small text-truncate mt-1" id="current-user-@op.Id">
                                <i class="bi bi-person-check me-1"></i>@op.CurrentUser
                            </div>
                        }
                    </div>
                    <div class="card-footer d-flex gap-2 flex-wrap">
                        <a asp-action="Detail" asp-route-id="@op.Id" class="btn btn-sm btn-outline-secondary flex-grow-1">
                            <i class="bi bi-eye me-1"></i>Details
                        </a>

                        @if (op.Status == OperationStatus.Running)
                        {
                            <form asp-action="Stop" asp-route-id="@op.Id" method="post" class="d-inline flex-grow-1">
                                <button type="submit" class="btn btn-sm btn-warning w-100"
                                        onclick="return confirmAction('Stop this operation?', this.form)">
                                    <i class="bi bi-stop-circle me-1"></i>Stop
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Start" asp-route-id="@op.Id" method="post" class="d-inline flex-grow-1">
                                <button type="submit" class="btn btn-sm btn-success w-100">
                                    <i class="bi bi-play-circle me-1"></i>Start
                                </button>
                            </form>
                        }

                        <form asp-action="Delete" asp-route-id="@op.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirmAction('Delete this operation and ALL its results?', this.form)">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<script>
    // Poll every 3 s to refresh card stats without full page reload
    startDashboardPolling(3000);
</script>
}
