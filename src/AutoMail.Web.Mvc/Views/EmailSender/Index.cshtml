@{
    ViewBag.Title = "Email Senders";
    Layout = "~/Views/Shared/Layout/_LayoutEmail.cshtml";
}

@section styles {
    <style>
        .sender-badge-active   { background: #28a745; color: #fff; padding: 2px 10px; border-radius: 12px; font-size: .8rem; }
        .sender-badge-inactive { background: #dc3545; color: #fff; padding: 2px 10px; border-radius: 12px; font-size: .8rem; }
    </style>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-mail-bulk text-primary"></i> Email Senders
                </h1>
            </div>
            <div class="col-sm-6 text-right">
                <a href="@Url.Action("Index", "BulkEmail")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Bulk Email
                </a>
            </div>
        </div>
    </div>
</div>

<form id="__AntiForgeryForm" style="display:none">@Html.AntiForgeryToken()</form>

<section class="content">
<div class="container-fluid">
<div class="row justify-content-center">
<div class="col-xl-10 col-lg-12">

    <div class="card card-primary card-outline">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-list mr-1"></i> Configured Senders</h3>
            <div class="card-tools">
                <button type="button" class="btn btn-primary btn-sm" id="btn-add-sender">
                    <i class="fas fa-plus mr-1"></i> Add Sender
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0" id="senders-table">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Display Name</th>
                        <th>SMTP Host</th>
                        <th>Daily Limit</th>
                        <th>Delay (ms)</th>
                        <th>Status</th>
                        <th style="width:140px">Actions</th>
                    </tr>
                </thead>
                <tbody id="senders-tbody">
                    <tr id="loading-row">
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="fas fa-spinner fa-spin mr-1"></i> Loading senders...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>
</div>
</div>
</section>

<!-- ═══════════════════════ Add / Edit Modal ═══════════════════════ -->
<div class="modal fade" id="sender-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modal-title">Add Email Sender</h5>
                <button type="button" class="close text-white" data-bs-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="sender-id" value="" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Email (SMTP username) <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="sender-email" maxlength="256"
                                   placeholder="sender@gmail.com" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Password (App Password) <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" id="sender-password" maxlength="512"
                                   placeholder="App password" />
                            <small class="text-muted" id="password-hint" style="display:none">Leave blank to keep existing password.</small>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Display Name</label>
                            <input type="text" class="form-control" id="sender-display-name" maxlength="128"
                                   placeholder="My Sender Name" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>SMTP Host</label>
                            <input type="text" class="form-control" id="sender-smtp-host" maxlength="256"
                                   value="smtp.gmail.com" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>SMTP Port</label>
                            <input type="number" class="form-control" id="sender-smtp-port" value="587" min="1" max="65535" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Enable SSL</label>
                            <select class="form-control" id="sender-enable-ssl">
                                <option value="true" selected>Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Daily Limit</label>
                            <input type="number" class="form-control" id="sender-daily-limit" value="500" min="1" max="10000" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Delay (ms)</label>
                            <input type="number" class="form-control" id="sender-delay" value="1000" min="0" max="60000" />
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="sender-active" checked />
                        <label class="custom-control-label" for="sender-active">Active</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-sender">
                    <i class="fas fa-save mr-1"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.all.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.min.css" />

    <script>
    (function ($) {
        'use strict';

        var modalEl = document.getElementById('sender-modal');
        var modal = new bootstrap.Modal(modalEl);

        function toast(icon, title, text) {
            Swal.fire({ icon: icon, title: title, text: text,
                        toast: true, position: 'top-end',
                        showConfirmButton: false, timer: 4000,
                        timerProgressBar: true });
        }

        function alertError(msg) {
            Swal.fire({ icon: 'error', title: 'Error', text: msg });
        }

        function getToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        // ── Load Senders ──
        function loadSenders() {
            $.ajax({
                url: '@Url.Action("GetAll", "EmailSender")',
                type: 'GET',
                success: function (resp) {
                    var list = resp.result || resp;
                    var tbody = $('#senders-tbody');
                    tbody.empty();

                    if (!list.length) {
                        tbody.html('<tr><td colspan="7" class="text-center py-4 text-muted">No senders configured. Click "Add Sender" to get started.</td></tr>');
                        return;
                    }

                    list.forEach(function (s) {
                        var badge = s.isActive
                            ? '<span class="sender-badge-active">Active</span>'
                            : '<span class="sender-badge-inactive">Inactive</span>';

                        tbody.append(
                            '<tr>' +
                            '<td>' + escapeHtml(s.email) + '</td>' +
                            '<td>' + escapeHtml(s.displayName || '—') + '</td>' +
                            '<td>' + escapeHtml(s.smtpHost) + ':' + s.smtpPort + '</td>' +
                            '<td>' + s.dailyLimit + '</td>' +
                            '<td>' + s.delayBetweenEmailsMs + '</td>' +
                            '<td>' + badge + '</td>' +
                            '<td>' +
                                '<button class="btn btn-sm btn-outline-primary mr-1 btn-edit" data-id="' + s.id + '"><i class="fas fa-edit"></i></button>' +
                                '<button class="btn btn-sm btn-outline-danger btn-delete" data-id="' + s.id + '" data-email="' + escapeHtml(s.email) + '"><i class="fas fa-trash"></i></button>' +
                            '</td>' +
                            '</tr>'
                        );
                    });
                },
                error: function () {
                    alertError('Failed to load senders.');
                }
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }

        // ── Add ──
        $('#btn-add-sender').on('click', function () {
            $('#modal-title').text('Add Email Sender');
            $('#sender-id').val('');
            $('#sender-email').val('');
            $('#sender-password').val('').attr('placeholder', 'App password').prop('required', true);
            $('#password-hint').hide();
            $('#sender-display-name').val('');
            $('#sender-smtp-host').val('smtp.gmail.com');
            $('#sender-smtp-port').val(587);
            $('#sender-enable-ssl').val('true');
            $('#sender-daily-limit').val(500);
            $('#sender-delay').val(1000);
            $('#sender-active').prop('checked', true);
            modal.show();
        });

        // ── Edit ──
        $(document).on('click', '.btn-edit', function () {
            var id = $(this).data('id');
            $.ajax({
                url: '@Url.Action("Get", "EmailSender")',
                data: { id: id },
                type: 'GET',
                success: function (resp) {
                    var s = resp.result || resp;
                    $('#modal-title').text('Edit Email Sender');
                    $('#sender-id').val(s.id);
                    $('#sender-email').val(s.email);
                    $('#sender-password').val('').attr('placeholder', 'Leave blank to keep existing').prop('required', false);
                    $('#password-hint').show();
                    $('#sender-display-name').val(s.displayName || '');
                    $('#sender-smtp-host').val(s.smtpHost);
                    $('#sender-smtp-port').val(s.smtpPort);
                    $('#sender-enable-ssl').val(s.enableSsl ? 'true' : 'false');
                    $('#sender-daily-limit').val(s.dailyLimit);
                    $('#sender-delay').val(s.delayBetweenEmailsMs);
                    $('#sender-active').prop('checked', s.isActive);
                    modal.show();
                },
                error: function () { alertError('Failed to load sender details.'); }
            });
        });

        // ── Save (Create / Update) ──
        $('#btn-save-sender').on('click', function () {
            var id = $('#sender-id').val();
            var isEdit = !!id;

            var payload = {
                email: $.trim($('#sender-email').val()),
                password: $.trim($('#sender-password').val()),
                displayName: $.trim($('#sender-display-name').val()),
                smtpHost: $.trim($('#sender-smtp-host').val()),
                smtpPort: parseInt($('#sender-smtp-port').val(), 10),
                enableSsl: $('#sender-enable-ssl').val() === 'true',
                isActive: $('#sender-active').is(':checked'),
                dailyLimit: parseInt($('#sender-daily-limit').val(), 10),
                delayBetweenEmailsMs: parseInt($('#sender-delay').val(), 10)
            };

            if (!payload.email) { alertError('Email is required.'); return; }
            if (!isEdit && !payload.password) { alertError('Password is required for new senders.'); return; }

            if (isEdit) payload.id = parseInt(id, 10);

            var url = isEdit
                ? '@Url.Action("Update", "EmailSender")'
                : '@Url.Action("Create", "EmailSender")';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                headers: { 'RequestVerificationToken': getToken() },
                success: function () {
                    modal.hide();
                    toast('success', 'Saved', 'Sender ' + (isEdit ? 'updated' : 'created') + ' successfully.');
                    loadSenders();
                },
                error: function (xhr) {
                    var msg = 'Failed to save sender.';
                    try {
                        var err = JSON.parse(xhr.responseText);
                        msg = (err.error && err.error.message) ? err.error.message : msg;
                    } catch (e) { }
                    alertError(msg);
                }
            });
        });

        // ── Delete ──
        $(document).on('click', '.btn-delete', function () {
            var id = $(this).data('id');
            var email = $(this).data('email');

            Swal.fire({
                title: 'Delete Sender?',
                html: 'Are you sure you want to delete <strong>' + escapeHtml(email) + '</strong>?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                confirmButtonText: 'Yes, delete'
            }).then(function (result) {
                if (!result.isConfirmed) return;

                $.ajax({
                    url: '@Url.Action("Delete", "EmailSender")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ id: id }),
                    headers: { 'RequestVerificationToken': getToken() },
                    success: function () {
                        toast('success', 'Deleted', 'Sender removed successfully.');
                        loadSenders();
                    },
                    error: function () { alertError('Failed to delete sender.'); }
                });
            });
        });

        // ── Init ──
        loadSenders();

    }(jQuery));
    </script>
}
