@{
    ViewBag.Title = "New Email Operation";
    Layout = "~/Views/Shared/Layout/_LayoutEmail.cshtml";
}

@section styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" />
    <style>
        .drop-zone {
            border: 2px dashed #1a7be4;
            border-radius: 8px;
            padding: 40px 20px;
            text-align: center;
            cursor: pointer;
            transition: background .25s, border-color .25s;
            background: #f8fbff;
        }
        .drop-zone:hover, .drop-zone.dragover {
            background: #e8f3ff;
            border-color: #0d5bbf;
        }
        .drop-zone .dz-icon { font-size: 3rem; color: #1a7be4; }
        .drop-zone .dz-label { font-size: 1rem; color: #555; margin-top: 8px; }
        .drop-zone .dz-hint  { font-size: .85rem; color: #999; margin-top: 4px; }

        #page-overlay {
            display: none;
            position: fixed; inset: 0;
            background: rgba(0,0,0,.35);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        #page-overlay.show { display: flex; }
        .spinner-border-lg { width: 3.5rem; height: 3.5rem; border-width: .4em; }

        .sender-badge-active   { background: #28a745; color: #fff; padding: 2px 10px; border-radius: 12px; font-size: .8rem; }
        .sender-badge-inactive { background: #dc3545; color: #fff; padding: 2px 10px; border-radius: 12px; font-size: .8rem; }
    </style>
}

<div id="page-overlay">
    <div class="spinner-border text-light spinner-border-lg" role="status">
        <span class="sr-only">Loading...</span>
    </div>
</div>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-plus-circle text-primary"></i> New Email Operation
                </h1>
            </div>
            <div class="col-sm-6 text-right">
                <a href="@Url.Action("Index", "BulkEmail")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Operations
                </a>
            </div>
        </div>
    </div>
</div>

<form id="__AntiForgeryForm" style="display:none">@Html.AntiForgeryToken()</form>

<section class="content">
<div class="container-fluid">
<div class="row justify-content-center">
<div class="col-xl-8 col-lg-10 col-12">

    <!-- ═══════════ Step 1 — Upload Recipients File ═══════════ -->
    <div class="card card-primary card-outline">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-upload mr-1"></i> Step 1 — Upload Recipients File</h3>
        </div>
        <div class="card-body">
            <div class="drop-zone" id="drop-zone">
                <div class="dz-icon"><i class="fas fa-cloud-upload-alt"></i></div>
                <div class="dz-label">Drop your file here or <strong>click to browse</strong></div>
                <div class="dz-hint">Supported formats: <strong>.xlsx</strong> and <strong>.csv</strong></div>
                <input type="file" id="file-input" accept=".xlsx,.csv" style="display:none" />
            </div>
            <div id="file-name-display" class="mt-2 text-info font-weight-bold" style="display:none"></div>

            <div class="form-group mt-3 mb-0">
                <label for="email-column-index">
                    Email Column Index
                    <small class="text-muted">(0 = first column)</small>
                </label>
                <input type="number" class="form-control" id="email-column-index"
                       value="0" min="0" max="99" style="max-width:160px" />
            </div>
        </div>
    </div>

    <!-- ═══════════ Step 2 — Compose Message ═══════════ -->
    <div class="card card-success card-outline">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-envelope-open-text mr-1"></i> Step 2 — Compose Message</h3>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label for="email-subject">Subject <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="email-subject"
                       placeholder="Enter email subject..." maxlength="500" />
            </div>
            <div class="form-group">
                <label for="email-body">Body <span class="text-danger">*</span></label>
                <div id="email-body"></div>
            </div>
        </div>
    </div>

    <!-- ═══════════ Step 2.5 — AI Generation Settings ═══════════ -->
    <div class="card card-warning card-outline">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-robot mr-1"></i> Step 2.5 — AI Template Generation</h3>
        </div>
        <div class="card-body">
            <div class="form-group mb-2">
                <label class="mb-1">AI Mode</label>
                <select class="form-control" id="ai-generation-mode" style="max-width:320px">
                    <option value="0" selected>Disabled (Manual templates only)</option>
                    <option value="1">Pre-generate template pool before send</option>
                </select>
                <small class="text-muted">When enabled, AI generates templates before the background send job starts.</small>
            </div>

            <div id="ai-settings-panel" style="display:none">
                <div class="form-row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Variant Count</label>
                            <input type="number" class="form-control" id="ai-variant-count" min="1" max="20" value="3" />
                            <small class="text-muted">Number of AI-generated templates.</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Tone</label>
                            <select class="form-control" id="ai-tone">
                                <option value="">Auto detect</option>
                                <option value="professional">Professional</option>
                                <option value="promotional">Promotional</option>
                                <option value="announcement">Announcement</option>
                                <option value="warm">Warm</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-0">
                    <label>AI Prompt</label>
                    <textarea class="form-control" id="ai-prompt" rows="3" maxlength="4000" placeholder="Optional campaign prompt for AI, e.g. Highlight new features for SaaS users and use a concise CTA."></textarea>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════ Step 3 — Email Senders ═══════════ -->
    <div class="card card-secondary card-outline">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-server mr-1"></i> Step 3 — Email Senders</h3>
            <div class="card-tools">
                <button type="button" class="btn btn-primary btn-sm" id="btn-add-sender">
                    <i class="fas fa-plus mr-1"></i> Add Sender
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover table-striped mb-0" id="senders-table">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Display Name</th>
                        <th>SMTP Host</th>
                        <th>Daily Limit</th>
                        <th>Status</th>
                        <th style="width:120px">Actions</th>
                    </tr>
                </thead>
                <tbody id="senders-tbody">
                    <tr><td colspan="6" class="text-center py-3 text-muted"><i class="fas fa-spinner fa-spin mr-1"></i> Loading...</td></tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted" id="sender-summary"></div>
    </div>

    <!-- ═══════════ Step 4 — Email Templates ═══════════ -->
    <div class="card card-info card-outline">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-copy mr-1"></i> Step 4 &mdash; Email Templates <small class="text-muted">(Optional)</small></h3>
            <div class="card-tools">
                <button type="button" class="btn btn-sm btn-primary" id="btn-add-create-tpl">
                    <i class="fas fa-plus mr-1"></i> Add Template
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div id="create-no-tpl-msg" class="text-center text-muted py-3">
                <i class="fas fa-info-circle mr-1"></i>
                No templates &mdash; the default subject &amp; body above will be used for all emails.
            </div>
            <table class="table table-sm table-hover mb-0" id="create-tpl-table" style="display:none">
                <thead class="thead-light">
                    <tr>
                        <th style="width:35px">#</th>
                        <th>Name</th>
                        <th>Subject</th>
                        <th style="width:70px">Weight</th>
                        <th style="width:70px">Chance</th>
                        <th style="width:90px"></th>
                    </tr>
                </thead>
                <tbody id="create-tpl-tbody"></tbody>
            </table>
        </div>
        <div class="card-footer text-muted small">
            <i class="fas fa-random mr-1"></i> The sending job picks one template per email using weighted random selection.
        </div>
    </div>

    <!-- ═══════════ Submit ═══════════ -->
    <div class="text-center mb-4">
        <button type="button" id="btn-draft" class="btn btn-secondary btn-lg mr-2" disabled>
            <i class="fas fa-save mr-1"></i> Save as Draft
        </button>
        <button type="button" id="btn-start" class="btn btn-success btn-lg" disabled>
            <i class="fas fa-rocket mr-1"></i> Start Operation
        </button>
        <div class="mt-2">
            <small class="text-muted">Draft operations can be edited and started later from the Operations list.</small>
        </div>
    </div>

</div>
</div>
</div>
</section>

<!-- ═══════════ Template Add / Edit Modal (Create page) ═══════════ -->
<div class="modal fade" id="create-tpl-modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info">
                <h5 class="modal-title text-white" id="create-tpl-modal-title">Add Template</h5>
                <button type="button" class="close text-white" data-bs-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="create-tpl-idx" value="">
                <div class="form-group">
                    <label>Name <small class="text-muted">(optional)</small></label>
                    <input type="text" id="create-tpl-name" class="form-control" placeholder="e.g. Friendly tone, Follow-up A...">
                </div>
                <div class="form-group">
                    <label>Subject <span class="text-danger">*</span></label>
                    <input type="text" id="create-tpl-subject" class="form-control">
                </div>
                <div class="form-group">
                    <label>Body <span class="text-danger">*</span></label>
                    <textarea id="create-tpl-body" class="form-control" rows="9"></textarea>
                </div>
                <div class="form-row align-items-center">
                    <div class="col-auto">
                        <label class="mb-0">Weight</label>
                        <input type="number" id="create-tpl-weight" class="form-control" style="width:90px" value="1" min="1" max="100">
                    </div>
                    <div class="col text-muted small mt-3">Higher weight = selected more often. Equal weights = equal chance.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-info" id="btn-save-create-tpl">
                    <i class="fas fa-save mr-1"></i> Save Template
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════ Sender Add / Edit Modal ═══════════ -->
<div class="modal fade" id="sender-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modal-title">Add Email Sender</h5>
                <button type="button" class="close text-white" data-bs-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="sender-id" value="" />
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Email (SMTP username) <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="sender-email" maxlength="256" placeholder="sender@gmail.com" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Password (App Password) <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" id="sender-password" maxlength="512" placeholder="App password" />
                            <small class="text-muted" id="password-hint" style="display:none">Leave blank to keep existing password.</small>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Display Name</label>
                            <input type="text" class="form-control" id="sender-display-name" maxlength="128" placeholder="My Sender Name" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>SMTP Host</label>
                            <input type="text" class="form-control" id="sender-smtp-host" maxlength="256" value="smtp.gmail.com" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>SMTP Port</label>
                            <input type="number" class="form-control" id="sender-smtp-port" value="587" min="1" max="65535" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Enable SSL</label>
                            <select class="form-control" id="sender-enable-ssl">
                                <option value="true" selected>Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Daily Limit</label>
                            <input type="number" class="form-control" id="sender-daily-limit" value="500" min="1" max="10000" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Delay (ms)</label>
                            <input type="number" class="form-control" id="sender-delay" value="1000" min="0" max="60000" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="sender-active" checked />
                        <label class="custom-control-label" for="sender-active">Active</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-sender"><i class="fas fa-save mr-1"></i> Save</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
    <script>
    (function ($) {
        'use strict';

        var overlay    = $('#page-overlay');
        var dropZone   = $('#drop-zone');
        var fileInput  = $('#file-input');
        var btnStart   = $('#btn-start');
        var btnDraft   = $('#btn-draft');
        var selectedFile = null;

        var modalEl = document.getElementById('sender-modal');
        var modal   = new bootstrap.Modal(modalEl);
        var tplModalEl = document.getElementById('create-tpl-modal');
        var tplModal   = new bootstrap.Modal(tplModalEl);

        function showLoading()  { overlay.addClass('show'); }
        function hideLoading()  { overlay.removeClass('show'); }

        function toast(icon, title, text) {
            Swal.fire({ icon: icon, title: title, text: text,
                        toast: true, position: 'top-end',
                        showConfirmButton: false, timer: 4000,
                        timerProgressBar: true });
        }
        function alertError(msg) {
            Swal.fire({ icon: 'error', title: 'Error', text: msg });
        }
        function getToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }
        function escapeHtml(str) {
            if (!str) return '';
            return $('<span>').text(str).html();
        }

        $('#email-body').summernote({
            height: 250,
            placeholder: 'Compose your email body here...',
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'italic', 'underline', 'strikethrough', 'clear']],
                ['fontname', ['fontname']],
                ['fontsize', ['fontsize']],
                ['color', ['color']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['table', ['table']],
                ['insert', ['link', 'picture', 'hr']],
                ['view', ['fullscreen', 'codeview', 'undo', 'redo']]
            ],
            callbacks: {
                onChange: function () { updateStartButton(); }
            }
        });

        function getBodyHtml() {
            return $('#email-body').summernote('code');
        }

        function updateStartButton() {
            var hasFile    = !!selectedFile;
            var hasSubject = $.trim($('#email-subject').val()).length > 0;
            var body       = getBodyHtml();
            var hasBody    = body && $.trim($('<div>').html(body).text()).length > 0;
            var ready = hasFile && hasSubject && hasBody;
            btnStart.prop('disabled', !ready);
            btnDraft.prop('disabled', !ready);
        }

        $('#email-subject').on('input', updateStartButton);

        function getAiMode() {
            return parseInt($('#ai-generation-mode').val(), 10) || 0;
        }

        function toggleAiPanel() {
            var enabled = getAiMode() === 1;
            $('#ai-settings-panel').toggle(enabled);
        }

        $('#ai-generation-mode').on('change', toggleAiPanel);
        toggleAiPanel();

        // ── File drag-drop ──────────────────────────────────────────────
        $(document).on('dragover drop', function (e) { e.preventDefault(); });
        fileInput.on('click', function (e) { e.stopPropagation(); });
        dropZone.on('click', function () { fileInput.trigger('click'); });
        dropZone.on('dragover', function (e) { e.preventDefault(); dropZone.addClass('dragover'); })
                .on('dragleave drop', function (e) { e.preventDefault(); dropZone.removeClass('dragover'); });

        dropZone.on('drop', function (e) {
            e.preventDefault();
            var files = e.originalEvent.dataTransfer.files;
            if (files.length) { fileInput[0].files = files; onFileSelected(files[0]); }
        });
        fileInput.on('change', function () { if (this.files.length) onFileSelected(this.files[0]); });

        function onFileSelected(file) {
            var ext = file.name.slice(file.name.lastIndexOf('.')).toLowerCase();
            if (!['.xlsx', '.csv'].includes(ext)) {
                alertError('Only .xlsx and .csv files are supported.');
                fileInput.val('');
                selectedFile = null;
                updateStartButton();
                return;
            }
            selectedFile = file;
            $('#file-name-display').text('\uD83D\uDCCE ' + file.name + '  (' + (file.size / 1024).toFixed(1) + ' KB)').show();
            updateStartButton();
        }

        // ── Sender management (inline) ──────────────────────────────────
        function loadSenders() {
            $.ajax({
                url: '@Url.Action("GetAll", "EmailSender")',
                type: 'GET',
                success: function (resp) {
                    var list = resp.result || resp;
                    var tbody = $('#senders-tbody');
                    tbody.empty();

                    if (!list.length) {
                        tbody.html('<tr><td colspan="6" class="text-center py-3 text-muted">No senders configured. Click "Add Sender" above.</td></tr>');
                        $('#sender-summary').text('No active senders — you need at least one to start an operation.');
                        return;
                    }

                    var activeCount = 0;
                    var totalCapacity = 0;
                    list.forEach(function (s) {
                        if (s.isActive) { activeCount++; totalCapacity += s.dailyLimit; }
                        var badge = s.isActive
                            ? '<span class="sender-badge-active">Active</span>'
                            : '<span class="sender-badge-inactive">Inactive</span>';
                        tbody.append(
                            '<tr>' +
                            '<td>' + escapeHtml(s.email) + '</td>' +
                            '<td>' + escapeHtml(s.displayName || '\u2014') + '</td>' +
                            '<td>' + escapeHtml(s.smtpHost) + ':' + s.smtpPort + '</td>' +
                            '<td>' + s.dailyLimit + '</td>' +
                            '<td>' + badge + '</td>' +
                            '<td>' +
                                '<button class="btn btn-sm btn-outline-primary mr-1 btn-edit" data-id="' + s.id + '"><i class="fas fa-edit"></i></button>' +
                                '<button class="btn btn-sm btn-outline-danger btn-delete" data-id="' + s.id + '" data-email="' + escapeHtml(s.email) + '"><i class="fas fa-trash"></i></button>' +
                            '</td>' +
                            '</tr>'
                        );
                    });
                    $('#sender-summary').html('<i class="fas fa-info-circle mr-1"></i>' + activeCount + ' active sender(s), total daily capacity: ' + totalCapacity + ' emails');
                }
            });
        }

        // ── Add sender ──
        $('#btn-add-sender').on('click', function () {
            $('#modal-title').text('Add Email Sender');
            $('#sender-id').val('');
            $('#sender-email').val('');
            $('#sender-password').val('').attr('placeholder', 'App password').prop('required', true);
            $('#password-hint').hide();
            $('#sender-display-name').val('');
            $('#sender-smtp-host').val('smtp.gmail.com');
            $('#sender-smtp-port').val(587);
            $('#sender-enable-ssl').val('true');
            $('#sender-daily-limit').val(500);
            $('#sender-delay').val(1000);
            $('#sender-active').prop('checked', true);
            modal.show();
        });

        // ── Edit sender ──
        $(document).on('click', '.btn-edit', function () {
            var id = $(this).data('id');
            $.ajax({
                url: '@Url.Action("Get", "EmailSender")',
                data: { id: id }, type: 'GET',
                success: function (resp) {
                    var s = resp.result || resp;
                    $('#modal-title').text('Edit Email Sender');
                    $('#sender-id').val(s.id);
                    $('#sender-email').val(s.email);
                    $('#sender-password').val('').attr('placeholder', 'Leave blank to keep existing').prop('required', false);
                    $('#password-hint').show();
                    $('#sender-display-name').val(s.displayName || '');
                    $('#sender-smtp-host').val(s.smtpHost);
                    $('#sender-smtp-port').val(s.smtpPort);
                    $('#sender-enable-ssl').val(s.enableSsl ? 'true' : 'false');
                    $('#sender-daily-limit').val(s.dailyLimit);
                    $('#sender-delay').val(s.delayBetweenEmailsMs);
                    $('#sender-active').prop('checked', s.isActive);
                    modal.show();
                },
                error: function () { alertError('Failed to load sender details.'); }
            });
        });

        // ── Save sender ──
        $('#btn-save-sender').on('click', function () {
            var id = $('#sender-id').val();
            var isEdit = !!id;
            var payload = {
                email: $.trim($('#sender-email').val()),
                password: $.trim($('#sender-password').val()),
                displayName: $.trim($('#sender-display-name').val()),
                smtpHost: $.trim($('#sender-smtp-host').val()),
                smtpPort: parseInt($('#sender-smtp-port').val(), 10),
                enableSsl: $('#sender-enable-ssl').val() === 'true',
                isActive: $('#sender-active').is(':checked'),
                dailyLimit: parseInt($('#sender-daily-limit').val(), 10),
                delayBetweenEmailsMs: parseInt($('#sender-delay').val(), 10)
            };
            if (!payload.email) { alertError('Email is required.'); return; }
            if (!isEdit && !payload.password) { alertError('Password is required for new senders.'); return; }
            if (isEdit) payload.id = parseInt(id, 10);
            var url = isEdit ? '@Url.Action("Update", "EmailSender")' : '@Url.Action("Create", "EmailSender")';
            $.ajax({
                url: url, type: 'POST', contentType: 'application/json',
                data: JSON.stringify(payload),
                headers: { 'RequestVerificationToken': getToken() },
                success: function () {
                    modal.hide();
                    toast('success', 'Saved', 'Sender ' + (isEdit ? 'updated' : 'created') + ' successfully.');
                    loadSenders();
                },
                error: function (xhr) {
                    var msg = 'Failed to save sender.';
                    try { var err = JSON.parse(xhr.responseText); msg = (err.error && err.error.message) ? err.error.message : msg; } catch (e) { }
                    alertError(msg);
                }
            });
        });

        // ── Delete sender ──
        $(document).on('click', '.btn-delete', function () {
            var id = $(this).data('id');
            var email = $(this).data('email');
            Swal.fire({
                title: 'Delete Sender?',
                html: 'Are you sure you want to delete <strong>' + escapeHtml(email) + '</strong>?',
                icon: 'warning', showCancelButton: true,
                confirmButtonColor: '#dc3545', confirmButtonText: 'Yes, delete'
            }).then(function (result) {
                if (!result.isConfirmed) return;
                $.ajax({
                    url: '@Url.Action("Delete", "EmailSender")', type: 'POST',
                    contentType: 'application/json', data: JSON.stringify({ id: id }),
                    headers: { 'RequestVerificationToken': getToken() },
                    success: function () {
                        toast('success', 'Deleted', 'Sender removed successfully.');
                        loadSenders();
                    },
                    error: function () { alertError('Failed to delete sender.'); }
                });
            });
        });

        // ── Create-page templates ───────────────────────────────────────
        var createTemplates = [];

        function renderCreateTemplates() {
            var $tbody = $('#create-tpl-tbody');
            $tbody.empty();
            if (!createTemplates.length) {
                $('#create-tpl-table').hide();
                $('#create-no-tpl-msg').show();
                return;
            }
            $('#create-no-tpl-msg').hide();
            $('#create-tpl-table').show();
            var total = createTemplates.reduce(function (s, t) { return s + t.weight; }, 0);
            createTemplates.forEach(function (t, i) {
                var chance = total > 0 ? Math.round((t.weight / total) * 100) : 0;
                var preview = t.subject.length > 55 ? t.subject.substring(0, 52) + '...' : t.subject;
                $tbody.append('<tr>' +
                    '<td>' + (i + 1) + '</td>' +
                    '<td>' + escapeHtml(t.name || '\u2014') + '</td>' +
                    '<td title="' + escapeHtml(t.subject) + '">' + escapeHtml(preview) + '</td>' +
                    '<td>' + t.weight + '</td>' +
                    '<td><span class="badge badge-info px-2">' + chance + '%</span></td>' +
                    '<td>' +
                        '<button class="btn btn-xs btn-outline-secondary mr-1" onclick="editCreateTpl(' + i + ')"><i class="fas fa-edit"></i></button>' +
                        '<button class="btn btn-xs btn-outline-danger" onclick="removeCreateTpl(' + i + ')"><i class="fas fa-trash"></i></button>' +
                    '</td>' +
                    '</tr>');
            });
        }

        window.editCreateTpl = function (idx) {
            var t = createTemplates[idx];
            $('#create-tpl-idx').val(idx);
            $('#create-tpl-name').val(t.name || '');
            $('#create-tpl-subject').val(t.subject);
            $('#create-tpl-body').val(t.body);
            $('#create-tpl-weight').val(t.weight);
            $('#create-tpl-modal-title').text('Edit Template');
            tplModal.show();
        };

        window.removeCreateTpl = function (idx) {
            createTemplates.splice(idx, 1);
            renderCreateTemplates();
        };

        $('#btn-add-create-tpl').on('click', function () {
            $('#create-tpl-idx').val('');
            $('#create-tpl-name').val('');
            $('#create-tpl-subject').val('');
            $('#create-tpl-body').val('');
            $('#create-tpl-weight').val(1);
            $('#create-tpl-modal-title').text('Add Template');
            tplModal.show();
        });

        $('#btn-save-create-tpl').on('click', function () {
            var idx = $('#create-tpl-idx').val();
            var subject = $.trim($('#create-tpl-subject').val());
            var body    = $.trim($('#create-tpl-body').val());
            if (!subject) { alertError('Subject is required.'); return; }
            if (!body)    { alertError('Body is required.'); return; }
            var entry = {
                name:    $.trim($('#create-tpl-name').val()),
                subject: subject,
                body:    body,
                weight:  parseInt($('#create-tpl-weight').val()) || 1
            };
            if (idx !== '') {
                createTemplates[parseInt(idx)] = entry;
            } else {
                createTemplates.push(entry);
            }
            tplModal.hide();
            renderCreateTemplates();
        });

        // ── Start Operation ─────────────────────────────────────────────
        function submitOperation(startImmediately) {
            if (!selectedFile) { alertError('Please select a file.'); return; }
            var subject = $.trim($('#email-subject').val());
            var body    = getBodyHtml();
            var bodyText = $.trim($('<div>').html(body).text());
            var aiMode = getAiMode();
            var aiVariantCount = parseInt($('#ai-variant-count').val(), 10) || 0;
            var aiPrompt = $.trim($('#ai-prompt').val());
            var aiTone = $.trim($('#ai-tone').val());
            if (!subject) { alertError('Please enter a subject.'); $('#email-subject').focus(); return; }
            if (!bodyText) { alertError('Please enter a body.'); $('#email-body').summernote('focus'); return; }
            if (aiMode === 1 && (aiVariantCount < 1 || aiVariantCount > 20)) {
                alertError('AI Variant Count must be between 1 and 20 when AI is enabled.');
                return;
            }

            var confirmTitle = startImmediately ? 'Start Operation?' : 'Save as Draft?';
            var confirmHtml  = startImmediately
                ? 'This will parse the uploaded file and queue a background sending job.<br><br>Continue?'
                : 'The operation will be saved without starting. You can start it later from the Operations list.';
            var confirmColor = startImmediately ? '#28a745' : '#6c757d';
            var confirmText  = startImmediately ? '<i class="fas fa-rocket"></i> Yes, Start!' : '<i class="fas fa-save"></i> Save Draft';

            Swal.fire({
                title: confirmTitle, html: confirmHtml,
                icon: 'question', showCancelButton: true,
                confirmButtonColor: confirmColor, confirmButtonText: confirmText, cancelButtonText: 'Cancel'
            }).then(function (result) {
                if (!result.isConfirmed) return;

                showLoading();
                var formData = new FormData();
                formData.append('File', selectedFile);
                formData.append('EmailColumnIndex', $('#email-column-index').val());
                formData.append('Subject', subject);
                formData.append('Body', body);
                formData.append('StartImmediately', startImmediately ? 'true' : 'false');
                formData.append('AiGenerationMode', aiMode.toString());
                formData.append('AiVariantCount', aiMode === 1 ? aiVariantCount.toString() : '0');
                formData.append('AiPrompt', aiPrompt);
                formData.append('AiTone', aiTone);

                $.ajax({
                    url: '@Url.Action("CreateOperation", "BulkEmail")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    headers: { 'RequestVerificationToken': getToken() },
                    success: function (resp) {
                        hideLoading();
                        var op = resp.result || resp;

                        function showSuccess() {
                            var icon  = startImmediately ? 'success' : 'info';
                            var title = startImmediately ? 'Operation Started!' : 'Draft Saved!';
                            var html  = startImmediately
                                ? 'Operation #' + op.id + ' has been created with <strong>' + op.totalEmails + '</strong> recipient(s).<br>Sending job is now queued.'
                                : 'Draft #' + op.id + ' saved with <strong>' + op.totalEmails + '</strong> recipient(s). Start it anytime from the Operations list.';
                            Swal.fire({ icon: icon, title: title, html: html, confirmButtonColor: '#28a745' })
                                .then(function () { window.location.href = '@Url.Action("Index", "BulkEmail")'; });
                        }

                        if (!createTemplates.length) { showSuccess(); return; }
                        var tasks = createTemplates.map(function (t) {
                            return $.ajax({
                                url: '@Url.Action("AddTemplate", "BulkEmail")',
                                type: 'POST', contentType: 'application/json',
                                data: JSON.stringify({ operationId: op.id, name: t.name, subject: t.subject, body: t.body, weight: t.weight }),
                                headers: { 'RequestVerificationToken': getToken() }
                            });
                        });
                        $.when.apply($, tasks).always(showSuccess);
                    },
                    error: function (xhr) {
                        hideLoading();
                        var msg = 'An unexpected error occurred.';
                        try { var err = JSON.parse(xhr.responseText); msg = (err.error && err.error.message) ? err.error.message : msg; } catch (e) { }
                        alertError(msg);
                    }
                });
            });
        }

        btnStart.on('click', function () { submitOperation(true); });
        btnDraft.on('click', function () { submitOperation(false); });

        // ── Init ──
        loadSenders();

    }(jQuery));
    </script>
}
