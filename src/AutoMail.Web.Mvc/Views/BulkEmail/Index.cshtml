@{
    ViewBag.Title = "Email Operations";
    Layout = "~/Views/Shared/Layout/_LayoutEmail.cshtml";
}

@section styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.min.css" />
    <style>
        .badge-pending      { background: #6c757d; color: #fff; }
        .badge-inprogress   { background: #007bff; color: #fff; }
        .badge-completed    { background: #28a745; color: #fff; }
        .badge-failed       { background: #dc3545; color: #fff; }
        .badge-partiallysent { background: #ffc107; color: #212529; }

        .ops-table th, .ops-table td { vertical-align: middle; }
        .ops-table .subject-col { max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

        #page-overlay {
            display: none;
            position: fixed; inset: 0;
            background: rgba(0,0,0,.35);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        #page-overlay.show { display: flex; }
        .spinner-border-lg { width: 3.5rem; height: 3.5rem; border-width: .4em; }
    </style>
}

<div id="page-overlay">
    <div class="spinner-border text-light spinner-border-lg" role="status">
        <span class="sr-only">Loading...</span>
    </div>
</div>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-paper-plane text-primary"></i> Email Operations
                </h1>
            </div>
            <div class="col-sm-6 text-right">
                <a href="@Url.Action("Create", "BulkEmail")" class="btn btn-primary">
                    <i class="fas fa-plus mr-1"></i> New Operation
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
<div class="container-fluid">
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover ops-table mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>#</th>
                        <th>Subject</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th>Sent</th>
                        <th>Failed</th>
                        <th>Pending</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="ops-tbody">
                    <tr id="loading-row">
                        <td colspan="9" class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
</section>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.all.min.js"></script>
    <script>
    (function ($) {
        'use strict';

        var refreshTimer = null;

        function escapeHtml(str) {
            if (!str) return '';
            return $('<span>').text(str).html();
        }

        function statusBadge(status) {
            var cls = 'badge-pending';
            var label = status;
            switch ((status || '').toLowerCase()) {
                case 'pending':       cls = 'badge-pending'; break;
                case 'inprogress':    cls = 'badge-inprogress'; label = 'In Progress'; break;
                case 'completed':     cls = 'badge-completed'; break;
                case 'failed':        cls = 'badge-failed'; break;
                case 'partiallysent': cls = 'badge-partiallysent'; label = 'Partially Sent'; break;
            }
            return '<span class="badge ' + cls + ' px-2 py-1">' + escapeHtml(label) + '</span>';
        }

        function formatDate(d) {
            if (!d) return '—';
            var dt = new Date(d);
            return dt.toLocaleDateString() + ' ' + dt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        function loadOperations() {
            $.ajax({
                url: '@Url.Action("GetAll", "BulkEmail")',
                type: 'GET',
                success: function (resp) {
                    var ops = resp.result || resp;
                    var tbody = $('#ops-tbody');
                    tbody.empty();

                    if (!ops || !ops.length) {
                        tbody.append('<tr><td colspan="9" class="text-center text-muted py-4">No operations yet. <a href="@Url.Action("Create", "BulkEmail")">Start a new one</a>.</td></tr>');
                        stopAutoRefresh();
                        return;
                    }

                    var hasInProgress = false;
                    $.each(ops, function (i, op) {
                        if ((op.statusText || '').toLowerCase() === 'inprogress') hasInProgress = true;
                        var actions = '<a href="@Url.Action("DetailPage", "BulkEmail")?id=' + op.id + '" class="btn btn-sm btn-outline-primary"><i class="fas fa-eye mr-1"></i>View</a>';
                        if (op.failedCount > 0) {
                            actions += ' <a href="@Url.Action("DownloadFailed", "BulkEmail")?id=' + op.id + '" class="btn btn-sm btn-outline-danger" title="Export failed emails"><i class="fas fa-file-csv"></i></a>';
                        }
                        tbody.append(
                            '<tr>' +
                            '<td>' + op.id + '</td>' +
                            '<td class="subject-col" title="' + escapeHtml(op.subject) + '">' + escapeHtml(op.subject) + '</td>' +
                            '<td>' + statusBadge(op.statusText) + '</td>' +
                            '<td>' + op.totalEmails + '</td>' +
                            '<td class="text-success font-weight-bold">' + op.sentCount + '</td>' +
                            '<td class="text-danger font-weight-bold">' + op.failedCount + '</td>' +
                            '<td>' + op.pendingCount + '</td>' +
                            '<td>' + formatDate(op.creationTime) + '</td>' +
                            '<td>' + actions + '</td>' +
                            '</tr>'
                        );
                    });

                    if (hasInProgress) {
                        startAutoRefresh();
                    } else {
                        stopAutoRefresh();
                    }
                }
            });
        }

        function startAutoRefresh() {
            if (!refreshTimer) {
                refreshTimer = setInterval(loadOperations, 5000);
            }
        }

        function stopAutoRefresh() {
            if (refreshTimer) {
                clearInterval(refreshTimer);
                refreshTimer = null;
            }
        }

        loadOperations();

    }(jQuery));
    </script>
}
