@{
    ViewBag.Title = "Email Operations";
    Layout = "~/Views/Shared/Layout/_LayoutEmail.cshtml";
}

@section styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.min.css" />
    <style>
        .badge-pending       { background: #6c757d; color: #fff; }
        .badge-inprogress    { background: #007bff; color: #fff; }
        .badge-completed     { background: #28a745; color: #fff; }
        .badge-failed        { background: #dc3545; color: #fff; }
        .badge-partiallysent { background: #ffc107; color: #212529; }
        .badge-paused        { background: #fd7e14; color: #fff; }
        .badge-cancelled     { background: #343a40; color: #fff; }

        .ops-table th, .ops-table td { vertical-align: middle; }
        .ops-table .subject-col { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

        .progress { height: 6px; border-radius: 3px; background: #e9ecef; margin-top: 4px; }
        .progress-bar { border-radius: 3px; transition: width .4s ease; }

        .op-actions .btn { padding: 2px 8px; font-size: .75rem; }

        #page-overlay {
            display: none;
            position: fixed; inset: 0;
            background: rgba(0,0,0,.35);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        #page-overlay.show { display: flex; }
        .spinner-border-lg { width: 3.5rem; height: 3.5rem; border-width: .4em; }

        tr.status-inprogress td:first-child { border-left: 3px solid #007bff; }
        tr.status-paused     td:first-child { border-left: 3px solid #fd7e14; }
    </style>
}

<div id="page-overlay">
    <div class="spinner-border text-light spinner-border-lg" role="status">
        <span class="sr-only">Loading...</span>
    </div>
</div>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-paper-plane text-primary"></i> Email Operations
                </h1>
            </div>
            <div class="col-sm-6 text-right">
                <a href="@Url.Action("Create", "BulkEmail")" class="btn btn-primary">
                    <i class="fas fa-plus mr-1"></i> New Operation
                </a>
            </div>
        </div>
    </div>
</div>

<form id="__AntiForgeryForm" style="display:none">@Html.AntiForgeryToken()</form>

<section class="content">
<div class="container-fluid">
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover ops-table mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>#</th>
                        <th>Subject</th>
                        <th>Status</th>
                        <th>Progress</th>
                        <th>Sent</th>
                        <th>Failed</th>
                        <th>Pending</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="ops-tbody">
                    <tr id="loading-row">
                        <td colspan="9" class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
</section>
    </div>
</div>
</section>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.all.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
    (function ($) {
        'use strict';

        var refreshTimer = null;
        var hubConnection = null;
        var subscribedOps = {};

        // ── Helpers ──────────────────────────────────────────────────────── //

        function getToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function escapeHtml(str) {
            if (!str) return '';
            return $('<span>').text(str).html();
        }

        function statusBadge(status) {
            var map = {
                'pending':       ['badge-pending',       'Pending'],
                'inprogress':    ['badge-inprogress',    'In Progress'],
                'completed':     ['badge-completed',     'Completed'],
                'failed':        ['badge-failed',        'Failed'],
                'partiallysent': ['badge-partiallysent', 'Partial'],
                'paused':        ['badge-paused',        'Paused'],
                'cancelled':     ['badge-cancelled',     'Cancelled']
            };
            var entry = map[(status || '').toLowerCase()] || ['badge-pending', status];
            return '<span class="badge ' + entry[0] + ' px-2 py-1">' + escapeHtml(entry[1]) + '</span>';
        }

        function formatDate(d) {
            if (!d) return '—';
            var dt = new Date(d);
            return dt.toLocaleDateString() + ' ' + dt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        function progressBar(sent, total, status) {
            if (!total) return '—';
            var pct = Math.round((sent / total) * 100);
            var color = status === 'completed'     ? 'bg-success'   :
                        status === 'failed'        ? 'bg-danger'    :
                        status === 'paused'        ? 'bg-warning'   :
                        status === 'cancelled'     ? 'bg-secondary' : 'bg-primary';
            return '<div style="min-width:90px">' +
                   '<small>' + sent + '/' + total + ' (' + pct + '%)</small>' +
                   '<div class="progress"><div class="progress-bar ' + color + '" style="width:' + pct + '%"></div></div>' +
                   '</div>';
        }

        function buildActionButtons(op) {
            var id   = op.id;
            var st   = (op.statusText || '').toLowerCase();
            var html = '';

            html += '<a href="@Url.Action("DetailPage", "BulkEmail")?id=' + id +
                    '" class="btn btn-sm btn-outline-primary mr-1" title="View"><i class="fas fa-eye"></i></a>';

            if (st === 'inprogress') {
                html += '<button class="btn btn-sm btn-warning mr-1 btn-pause" data-id="' + id + '" title="Pause"><i class="fas fa-pause"></i></button>';
            }
            if (st === 'inprogress' || st === 'paused') {
                html += '<button class="btn btn-sm btn-danger mr-1 btn-stop" data-id="' + id + '" title="Stop"><i class="fas fa-stop"></i></button>';
            }
            if (st === 'paused' || st === 'cancelled' || st === 'partiallysent') {
                html += '<button class="btn btn-sm btn-success mr-1 btn-reactivate" data-id="' + id + '" title="Reactivate"><i class="fas fa-play"></i></button>';
            }
            if (op.failedCount > 0 && (st === 'failed' || st === 'partiallysent')) {
                html += '<a href="@Url.Action("DetailPage", "BulkEmail")?id=' + id +
                        '" class="btn btn-sm btn-outline-warning" title="View to retry"><i class="fas fa-redo"></i></a>';
            }

            return '<div class="op-actions d-flex flex-wrap">' + html + '</div>';
        }

        function renderRow(op) {
            var st = (op.statusText || '').toLowerCase();
            return $('<tr>')
                .attr('id', 'op-row-' + op.id)
                .addClass('status-' + st)
                .html(
                    '<td>' + op.id + '</td>' +
                    '<td class="subject-col" title="' + escapeHtml(op.subject) + '">' + escapeHtml(op.subject) + '</td>' +
                    '<td id="op-status-' + op.id + '">' + statusBadge(op.statusText) + '</td>' +
                    '<td id="op-progress-' + op.id + '">' + progressBar(op.sentCount, op.totalEmails, st) + '</td>' +
                    '<td class="text-success font-weight-bold" id="op-sent-' + op.id + '">' + op.sentCount + '</td>' +
                    '<td class="text-danger font-weight-bold" id="op-failed-' + op.id + '">' + op.failedCount + '</td>' +
                    '<td id="op-pending-' + op.id + '">' + op.pendingCount + '</td>' +
                    '<td>' + formatDate(op.creationTime) + '</td>' +
                    '<td id="op-actions-' + op.id + '">' + buildActionButtons(op) + '</td>'
                );
        }

        function updateRow(opId, sent, failed, pending, total, statusText) {
            var st = (statusText || '').toLowerCase();
            $('#op-row-' + opId).removeClass().addClass('status-' + st);
            $('#op-status-' + opId).html(statusBadge(statusText));
            $('#op-progress-' + opId).html(progressBar(sent, total, st));
            $('#op-sent-' + opId).text(sent);
            $('#op-failed-' + opId).text(failed);
            $('#op-pending-' + opId).text(pending);
        }

        // ── Load all operations ──────────────────────────────────────────── //

        function loadOperations() {
            $.ajax({
                url: '@Url.Action("GetAll", "BulkEmail")',
                type: 'GET',
                success: function (resp) {
                    var ops = resp.result || resp;
                    var tbody = $('#ops-tbody');
                    tbody.empty();

                    if (!ops || !ops.length) {
                        tbody.append('<tr><td colspan="9" class="text-center text-muted py-4">No operations yet. <a href="@Url.Action("Create", "BulkEmail")">Start a new one</a>.</td></tr>');
                        stopAutoRefresh();
                        return;
                    }

                    var hasActive = false;
                    $.each(ops, function (i, op) {
                        var st = (op.statusText || '').toLowerCase();
                        if (st === 'inprogress' || st === 'pending') hasActive = true;
                        tbody.append(renderRow(op));
                    });

                    bindActionButtons();
                    subscribeToActiveOps(ops);

                    if (hasActive) startAutoRefresh();
                    else           stopAutoRefresh();
                }
            });
        }

        function startAutoRefresh() {
            if (!refreshTimer) refreshTimer = setInterval(loadOperations, 5000);
        }

        function stopAutoRefresh() {
            if (refreshTimer) { clearInterval(refreshTimer); refreshTimer = null; }
        }

        // ── SignalR ──────────────────────────────────────────────────────── //

        function initSignalR() {
            hubConnection = new signalR.HubConnectionBuilder()
                .withUrl('/signalr-email')
                .withAutomaticReconnect()
                .build();

            hubConnection.on('OnEmailSent', function (n) {
                updateRow(n.operationId, n.sentCount, n.failedCount, n.pendingCount, n.totalEmails, 'InProgress');
                $('#op-actions-' + n.operationId).html(buildActionButtons({
                    id: n.operationId, statusText: 'InProgress',
                    failedCount: n.failedCount, sentCount: n.sentCount
                }));
                bindActionButtons();
            });

            hubConnection.on('OnStatusChanged', function (n) {
                updateRow(n.operationId, n.sentCount, n.failedCount, n.pendingCount, n.totalEmails, n.status);
                $('#op-actions-' + n.operationId).html(buildActionButtons({
                    id: n.operationId, statusText: n.status,
                    failedCount: n.failedCount, sentCount: n.sentCount
                }));
                bindActionButtons();
            });

            hubConnection.start().catch(function (err) {
                console.warn('SignalR connection failed (using polling as fallback):', err);
            });
        }

        function subscribeToActiveOps(ops) {
            if (!hubConnection || hubConnection.state !== signalR.HubConnectionState.Connected) return;
            $.each(ops, function (i, op) {
                var st = (op.statusText || '').toLowerCase();
                if ((st === 'inprogress' || st === 'pending') && !subscribedOps[op.id]) {
                    subscribedOps[op.id] = true;
                    hubConnection.invoke('SubscribeToOperation', op.id).catch(function(e) {
                        console.warn('Subscribe failed:', e);
                    });
                }
            });
        }

        // ── Action button handlers ────────────────────────────────────────── //

        function bindActionButtons() {
            $(document).off('click', '.btn-pause').on('click', '.btn-pause', function () {
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Pause Operation?',
                    text: 'Sending will stop within the next few emails.',
                    icon: 'question', showCancelButton: true,
                    confirmButtonColor: '#fd7e14',
                    confirmButtonText: '<i class="fas fa-pause"></i> Pause'
                }).then(function (r) { if (r.isConfirmed) controlOp('@Url.Action("Pause", "BulkEmail")', id, 'Paused'); });
            });

            $(document).off('click', '.btn-stop').on('click', '.btn-stop', function () {
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Stop Operation?',
                    text: 'The operation will be cancelled. You can reactivate it later.',
                    icon: 'warning', showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    confirmButtonText: '<i class="fas fa-stop"></i> Stop'
                }).then(function (r) { if (r.isConfirmed) controlOp('@Url.Action("Stop", "BulkEmail")', id, 'Stopped'); });
            });

            $(document).off('click', '.btn-reactivate').on('click', '.btn-reactivate', function () {
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Reactivate Operation?',
                    text: 'A new sending job will be queued for remaining pending emails.',
                    icon: 'question', showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    confirmButtonText: '<i class="fas fa-play"></i> Reactivate'
                }).then(function (r) { if (r.isConfirmed) controlOp('@Url.Action("Reactivate", "BulkEmail")', id, 'Reactivated'); });
            });
        }

        function controlOp(url, id, label) {
            $.ajax({
                url: url, type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ id: id }),
                headers: { 'RequestVerificationToken': getToken() },
                success: function () {
                    Swal.fire({ icon: 'success', title: label, timer: 1500, showConfirmButton: false });
                    setTimeout(loadOperations, 400);
                },
                error: function (xhr) {
                    var msg = 'An error occurred.';
                    try { var e = JSON.parse(xhr.responseText); msg = (e.error && e.error.message) ? e.error.message : msg; } catch(_) {}
                    Swal.fire({ icon: 'error', title: 'Error', text: msg });
                }
            });
        }

        // ── Init ─────────────────────────────────────────────────────────── //

        initSignalR();
        loadOperations();

    }(jQuery));
    </script>
}
