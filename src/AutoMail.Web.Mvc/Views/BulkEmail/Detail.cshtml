@{
    ViewBag.Title = "Operation Detail";
    Layout = "~/Views/Shared/Layout/_LayoutEmail.cshtml";
    var operationId = (long)ViewBag.OperationId;
}

@section styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" />
    <style>
        .badge-pending       { background: #6c757d; color: #fff; }
        .badge-inprogress    { background: #007bff; color: #fff; }
        .badge-completed     { background: #28a745; color: #fff; }
        .badge-failed        { background: #dc3545; color: #fff; }
        .badge-paused        { background: #fd7e14; color: #fff; }
        .badge-cancelled     { background: #343a40; color: #fff; }
        .badge-success-email { background: #28a745; color: #fff; }

        .stat-card .stat-value { font-size: 2rem; font-weight: 700; transition: color .3s; }
        .stat-card .stat-label { font-size: .85rem; color: #888; }
        .stat-value.bump { transform: scale(1.1); transition: transform .15s; }
        .progress-lg .progress-bar { border-radius: 5px; transition: width .5s ease; }

        #page-overlay {
            display: none;
            position: fixed; inset: 0;
            background: rgba(0,0,0,.35);
            z-index: 9999;
            justify-content: center;
        }
        #page-overlay.show { display: flex; }
        .spinner-border-lg { width: 3.5rem; height: 3.5rem; border-width: .4em; }

        .email-table td { font-size: .9rem; }
        .body-preview { max-height: 200px; overflow-y: auto; border: 1px solid #dee2e6; padding: 12px; border-radius: 4px; background: #f8f9fa; }
        /* Highlight new rows added via SignalR */
        @@keyframes row-flash { from { background: #d4edda; } to { background: transparent; } }
        tr.row-new { animation: row-flash 1.5s ease-out; }
    </style>
    }

<div id="page-overlay">
    <div class="spinner-border text-light spinner-border-lg" role="status">
        <span class="sr-only">Loading...</span>
    </div>
</div>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-info-circle text-primary"></i> Operation #<span id="op-id">@operationId</span>
                </h1>
            </div>
            <div class="col-sm-6 text-right">
                <a href="@Url.Action("Index", "BulkEmail")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Operations
                </a>
            </div>
        </div>
    </div>
</div>

<form id="__AntiForgeryForm" style="display:none">@Html.AntiForgeryToken()</form>

<section class="content">
<div class="container-fluid">

    <!-- Summary Card -->
    <div class="card card-primary card-outline">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-chart-bar mr-1"></i> Summary</h3>
            <div class="card-tools d-flex align-items-center">
                <!-- Operation control buttons -->
                <div id="op-controls" class="mr-2"></div>
                <span class="badge px-3 py-2" id="op-status-badge" style="font-size:.9rem">Loading...</span>
            </div>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-8">
                    <strong>Subject:</strong> <span id="op-subject" class="ml-1">—</span>
                </div>
                <div class="col-md-4 text-md-right text-muted">
                    <small>Created: <span id="op-created">—</span></small>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-12">
                    <strong>Body (read-only preview):</strong>
                    <div class="body-preview mt-1" id="op-body">—</div>
                </div>
            </div>

            <!-- Live progress bar (visible when InProgress) -->
            <div id="progress-section" style="display:none" class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <small class="text-muted">Sending progress</small>
                    <small id="progress-label" class="font-weight-bold">0%</small>
                </div>
                <div class="progress-lg">
                    <div class="progress-bar bg-primary" id="progress-bar" style="width:0%"></div>
                </div>
            </div>

            <div class="row text-center">
                <div class="col-md-3 col-6">
                    <div class="stat-card">
                        <span class="stat-value text-primary" id="stat-total">-</span>
                        <span class="stat-label d-block">Total</span>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-card">
                        <span class="stat-value text-success" id="stat-sent">-</span>
                        <span class="stat-label d-block">Sent</span>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-card">
                        <span class="stat-value text-danger" id="stat-failed">-</span>
                        <span class="stat-label d-block">Failed</span>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-card">
                        <span class="stat-value text-secondary" id="stat-pending">-</span>
                        <span class="stat-label d-block">Pending</span>
                    </div>
                </div>
            </div>
            <div class="row mt-3 text-muted text-center">
                <div class="col-md-4"><small>Started: <span id="op-started">—</span></small></div>
                <div class="col-md-4"><small>Completed: <span id="op-completed">—</span></small></div>
                <div class="col-md-4"></div>
            </div>
            <!-- Stop reason banner – shown when the operation stopped early -->
            <div id="stop-reason-row" class="mt-3" style="display:none">
                <div class="alert alert-warning py-2 mb-0">
                    <i class="fas fa-exclamation-triangle mr-2"></i>
                    <strong>Why it stopped:</strong> <span id="stop-reason-text"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Email Templates card -->
    <div class="card card-outline card-info">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-copy mr-1"></i> Email Templates
                <small class="text-muted ml-2" id="tpl-header-hint"></small>
            </h3>
            <div class="card-tools">
                <button type="button" class="btn btn-sm btn-primary" id="btn-add-template">
                    <i class="fas fa-plus mr-1"></i> Add Template
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div id="no-templates-msg" class="text-center text-muted py-3">
                <i class="fas fa-info-circle mr-1"></i>
                No templates — operation uses the default subject &amp; body.
            </div>
            <table class="table table-sm table-hover mb-0" id="templates-table" style="display:none">
                <thead class="thead-light">
                    <tr>
                        <th style="width:35px">#</th>
                        <th>Name</th>
                        <th>Subject</th>
                        <th style="width:70px">Weight</th>
                        <th style="width:70px">Chance</th>
                        <th style="width:90px"></th>
                    </tr>
                </thead>
                <tbody id="templates-tbody"></tbody>
            </table>
        </div>
    </div>

    <!-- Template add/edit modal -->
    <div class="modal fade" id="template-modal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary">
                    <h5 class="modal-title text-white" id="tpl-modal-title">Add Template</h5>
                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="tpl-id">
                    <div class="form-group">
                        <label>Name <small class="text-muted">(optional)</small></label>
                        <input type="text" id="tpl-name" class="form-control" placeholder="e.g. Friendly tone, Follow-up A...">
                    </div>
                    <div class="form-group">
                        <label>Subject <span class="text-danger">*</span></label>
                        <input type="text" id="tpl-subject" class="form-control">
                    </div>
                    <div class="form-group">
                        <label>Body <span class="text-danger">*</span></label>
                        <div id="tpl-body"></div>
                    </div>
                    <div class="form-row align-items-center">
                        <div class="col-auto">
                            <label class="mb-0">Weight</label>
                            <input type="number" id="tpl-weight" class="form-control" style="width:90px" value="1" min="1" max="100">
                        </div>
                        <div class="col text-muted small mt-3">Higher weight = selected more often. Equal weights = equal chance.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btn-save-tpl">
                        <i class="fas fa-save mr-1"></i> Save Template
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions (failures / retry / download) -->
    <div class="card card-outline card-warning" id="actions-card" style="display:none">
        <div class="card-body">
            <div class="btn-group flex-wrap">
                <a href="@Url.Action("DownloadFailed", "BulkEmail")?id=@operationId" class="btn btn-outline-danger mr-1" id="btn-download-failed">
                    <i class="fas fa-file-csv mr-1"></i> Download Failed (CSV)
                </a>
                <button type="button" class="btn btn-outline-warning" id="btn-retry">
                    <i class="fas fa-redo mr-1"></i> Retry Failed Emails
                </button>
            </div>
            <small class="text-muted ml-2" id="retry-info"></small>
        </div>
    </div>

    <!-- Email Details (expandable) -->
    <div class="card card-outline card-secondary">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-list mr-1"></i> Email Details</h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse" id="btn-toggle-emails">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>
        <div class="card-body p-0" style="display: none;">
            <table class="table table-sm table-hover email-table mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Sender Used</th>
                        <th>Sent At</th>
                        <th>Retries</th>
                        <th>Error</th>
                    </tr>
                </thead>
                <tbody id="emails-tbody">
                    <tr><td colspan="6" class="text-center py-3"><div class="spinner-border text-primary spinner-border-sm"></div></td></tr>
                </tbody>
            </table>
        </div>
    </div>

</div>
</section>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
    (function ($) {
        'use strict';

        var opId = @operationId;
        var refreshTimer = null;
        var hubConnection = null;
        var currentStatus = '';
        var totalEmails = 0;

        // ── Helpers ──────────────────────────────────────────────────────── //

        function escapeHtml(str) {
            if (!str) return '';
            return $('<span>').text(str).html();
        }

        function formatDate(d) {
            if (!d) return '\u2014';
            var dt = new Date(d);
            return dt.toLocaleDateString() + ' ' + dt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        function statusBadge(status) {
            var map = {
                'pending':       ['badge-pending',       'Pending'],
                'inprogress':    ['badge-inprogress',    'In Progress'],
                'completed':     ['badge-completed',     'Completed'],
                'failed':        ['badge-failed',        'Failed'],
                'partiallysent': ['badge-partiallysent', 'Partially Sent'],
                'paused':        ['badge-paused',        'Paused'],
                'cancelled':     ['badge-cancelled',     'Cancelled'],
                'success':       ['badge-success-email', 'Sent']
            };
            var entry = map[(status || '').toLowerCase()] || ['badge-pending', status];
            return '<span class="badge ' + entry[0] + ' px-2 py-1">' + escapeHtml(entry[1]) + '</span>';
        }

        function toast(icon, title, text) {
            Swal.fire({ icon: icon, title: title, text: text,
                        toast: true, position: 'top-end',
                        showConfirmButton: false, timer: 4000, timerProgressBar: true });
        }

        function alertError(msg) {
            Swal.fire({ icon: 'error', title: 'Error', text: msg });
        }

        $('#tpl-body').summernote({
            height: 220,
            placeholder: 'Design this template body...',
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'italic', 'underline', 'strikethrough', 'clear']],
                ['fontname', ['fontname']], ['fontsize', ['fontsize']], ['color', ['color']],
                ['para', ['ul', 'ol', 'paragraph']], ['table', ['table']],
                ['insert', ['link', 'picture', 'hr']], ['view', ['fullscreen', 'codeview', 'undo', 'redo']]
            ]
        });

        function getToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        // ── Progress bar ─────────────────────────────────────────────────── //

        function updateProgress(sent, total, status) {
            var st = (status || '').toLowerCase();
            if (st === 'inprogress' || st === 'paused') {
                $('#progress-section').show();
                var pct = total > 0 ? Math.round((sent / total) * 100) : 0;
                var color = st === 'paused' ? 'bg-warning' : 'bg-primary';
                $('#progress-bar')
                    .removeClass('bg-primary bg-warning bg-success bg-danger bg-secondary')
                    .addClass(color)
                    .css('width', pct + '%');
                $('#progress-label').text(pct + '%');
            } else if (st === 'completed') {
                $('#progress-section').show();
                $('#progress-bar').removeClass().addClass('progress-bar bg-success').css('width', '100%');
                $('#progress-label').text('100%');
            } else {
                $('#progress-section').hide();
            }
        }

        // ── Operation controls ───────────────────────────────────────────── //

        function renderControls(status) {
            var st = (status || '').toLowerCase();
            var html = '';

            if (st === 'inprogress') {
                html += '<button class="btn btn-sm btn-warning mr-1" id="btn-pause"><i class="fas fa-pause mr-1"></i>Pause</button>';
                html += '<button class="btn btn-sm btn-danger mr-1" id="btn-stop"><i class="fas fa-stop mr-1"></i>Stop</button>';
            }
            if (st === 'paused' || st === 'cancelled' || st === 'partiallysent') {
                html += '<button class="btn btn-sm btn-success mr-1" id="btn-reactivate"><i class="fas fa-play mr-1"></i>Reactivate</button>';
                html += '<button class="btn btn-sm btn-outline-success mr-1" id="btn-complete-send"><i class="fas fa-check-double mr-1"></i>Complete Send</button>';
            }
            if (st === 'paused' || st === 'partiallysent') {
                html += '<button class="btn btn-sm btn-danger mr-1" id="btn-stop"><i class="fas fa-stop mr-1"></i>Stop</button>';
            }
            if (st === 'failed') {
                html += '<button class="btn btn-sm btn-outline-success mr-1" id="btn-complete-send"><i class="fas fa-check-double mr-1"></i>Complete Send</button>';
            }

            $('#op-controls').html(html);
            bindControlButtons();
        }

        function bindControlButtons() {
            $('#btn-pause').off('click').on('click', function () {
                Swal.fire({
                    title: 'Pause Operation?',
                    text: 'Sending will stop after the current email.',
                    icon: 'question', showCancelButton: true,
                    confirmButtonColor: '#fd7e14',
                    confirmButtonText: '<i class="fas fa-pause"></i> Pause'
                }).then(function (r) { if (r.isConfirmed) controlOp('@Url.Action("Pause", "BulkEmail")', 'Paused'); });
            });

            $('#btn-stop').off('click').on('click', function () {
                Swal.fire({
                    title: 'Stop Operation?',
                    text: 'The operation will be cancelled. Remaining emails stay pending and can be reactivated.',
                    icon: 'warning', showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    confirmButtonText: '<i class="fas fa-stop"></i> Stop'
                }).then(function (r) { if (r.isConfirmed) controlOp('@Url.Action("Stop", "BulkEmail")', 'Stopped'); });
            });

            $('#btn-reactivate').off('click').on('click', function () {
                Swal.fire({
                    title: 'Reactivate Operation?',
                    text: 'A new sending job will resume from the remaining pending emails.',
                    icon: 'question', showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    confirmButtonText: '<i class="fas fa-play"></i> Reactivate'
                }).then(function (r) { if (r.isConfirmed) controlOp('@Url.Action("Reactivate", "BulkEmail")', 'Reactivated'); });
            });

            $('#btn-complete-send').off('click').on('click', function () {
                Swal.fire({
                    title: 'Complete Unsent Emails?',
                    text: 'This will queue sending for all unsent emails (pending + failed).',
                    icon: 'question', showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    confirmButtonText: '<i class="fas fa-check-double"></i> Complete Send'
                }).then(function (r) { if (r.isConfirmed) controlOp('@Url.Action("CompleteSend", "BulkEmail")', 'Queued'); });
            });
        }

        function controlOp(url, label) {
            $.ajax({
                url: url, type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ id: opId }),
                headers: { 'RequestVerificationToken': getToken() },
                success: function () {
                    toast('success', label, '');
                    setTimeout(loadDetail, 400);
                },
                error: function (xhr) {
                    var msg = 'An error occurred.';
                    try { var e = JSON.parse(xhr.responseText); msg = (e.error && e.error.message) ? e.error.message : msg; } catch(_) {}
                    alertError(msg);
                }
            });
        }

        // ── Load full detail from server ─────────────────────────────────── //

        function loadDetail() {
            $.ajax({
                url: '@Url.Action("Detail", "BulkEmail")',
                data: { id: opId },
                type: 'GET',
                success: function (resp) {
                    var op = resp.result || resp;
                    applyOpData(op);
                    renderEmailsTable(op.emails || []);
                }
            });
        }

        function applyOpData(op) {
            currentStatus = op.statusText || '';
            totalEmails = op.totalEmails || 0;

            $('#op-subject').text(op.subject);
            $('#op-body').html(op.body);
            $('#op-created').text(formatDate(op.creationTime));
            $('#op-started').text(formatDate(op.startedAt));
            $('#op-completed').text(formatDate(op.completedAt));
            $('#op-status-badge').html(statusBadge(op.statusText));

            $('#stat-total').text(op.totalEmails);
            $('#stat-sent').text(op.sentCount);
            $('#stat-failed').text(op.failedCount);
            $('#stat-pending').text(op.pendingCount);

            updateProgress(op.sentCount, op.totalEmails, op.statusText);
            renderControls(op.statusText);
            templateCache = op.templates || [];
            renderTemplatesTable(templateCache);

            // Stop reason banner
            if (op.stopReason) {
                $('#stop-reason-text').text(op.stopReason);
                $('#stop-reason-row').show();
            } else {
                $('#stop-reason-row').hide();
            }

            // Failed actions card
            if (op.failedCount > 0) {
                $('#actions-card').show();
                if (op.retryableCount > 0) {
                    $('#btn-retry').show();
                    $('#retry-info').text(op.retryableCount + ' email(s) can be retried.');
                } else {
                    $('#btn-retry').hide();
                    $('#retry-info').text('All failed emails have reached the max retry limit.');
                }
            } else {
                $('#actions-card').hide();
            }

            var st = (op.statusText || '').toLowerCase();
            if (st === 'inprogress' || st === 'pending') startAutoRefresh();
            else stopAutoRefresh();
        }

        // ── Emails table ─────────────────────────────────────────────────── //

        function renderEmailsTable(emails) {
            var tbody = $('#emails-tbody');
            tbody.empty();
            if (emails.length) {
                emails.forEach(function (e) {
                    tbody.append(buildEmailRow(e));
                });
            } else {
                tbody.append('<tr><td colspan="6" class="text-center text-muted py-3">No emails in this operation.</td></tr>');
            }
        }

        function buildEmailRow(e, flash) {
            var cls = flash ? (e.statusText === 'Success' ? 'row-new' : 'row-new-fail') : '';
            return '<tr class="' + cls + '">' +
                '<td>' + escapeHtml(e.email) + '</td>' +
                '<td>' + statusBadge(e.statusText) + '</td>' +
                '<td>' + escapeHtml(e.senderEmail || '\u2014') + '</td>' +
                '<td>' + formatDate(e.sentAt) + '</td>' +
                '<td>' + (e.retryCount || 0) + '</td>' +
                '<td>' + escapeHtml(e.errorMessage || '\u2014') + '</td>' +
                '</tr>';
        }

        // ── SignalR: receive per-email notification ───────────────────────── //

        function initSignalR() {
            hubConnection = new signalR.HubConnectionBuilder()
                .withUrl('/signalr-email')
                .withAutomaticReconnect()
                .build();

            hubConnection.on('OnEmailSent', function (n) {
                // Update stats live
                $('#stat-sent').text(n.sentCount);
                $('#stat-failed').text(n.failedCount);
                $('#stat-pending').text(Math.max(0, n.pendingCount));

                updateProgress(n.sentCount, n.totalEmails, 'InProgress');

                // Prepend new row to email table
                var fakeEmail = {
                    email:        n.email,
                    statusText:   n.status === 'Sent' ? 'Success' : 'Failed',
                    senderEmail:  n.senderEmail,
                    sentAt:       n.sentAt ? new Date(n.sentAt) : null,
                    retryCount:   0,
                    errorMessage: n.errorMessage || null
                };
                var $tbody = $('#emails-tbody');
                // Remove the "no emails" placeholder row if present
                $tbody.find('td[colspan]').closest('tr').remove();
                $tbody.prepend(buildEmailRow(fakeEmail, true));
            });

            hubConnection.on('OnStatusChanged', function (n) {
                currentStatus = n.status;
                $('#op-status-badge').html(statusBadge(n.status));
                $('#stat-sent').text(n.sentCount);
                $('#stat-failed').text(n.failedCount);
                $('#stat-pending').text(Math.max(0, n.pendingCount));
                updateProgress(n.sentCount, n.totalEmails, n.status);
                renderControls(n.status);

                // Show/hide actions card
                if (n.failedCount > 0) {
                    $('#actions-card').show();
                } else {
                    $('#actions-card').hide();
                }

                var st = (n.status || '').toLowerCase();
                if (st === 'completed' || st === 'failed' || st === 'partiallysent') {
                    stopAutoRefresh();
                    toast('info', 'Operation ' + n.status, 'Sent: ' + n.sentCount + ' | Failed: ' + n.failedCount);
                    // Reload to get final accurate data
                    setTimeout(loadDetail, 800);
                }
                if (st === 'paused') {
                    stopAutoRefresh();
                    toast('warning', 'Paused', 'Operation has been paused.');
                }
            });

            hubConnection.start().then(function () {
                hubConnection.invoke('SubscribeToOperation', opId).catch(function(e) {
                    console.warn('Subscribe failed:', e);
                });
            }).catch(function (err) {
                console.warn('SignalR failed (polling as fallback):', err);
            });
        }

        function startAutoRefresh() {
            if (!refreshTimer) refreshTimer = setInterval(loadDetail, 5000);
        }

        function stopAutoRefresh() {
            if (refreshTimer) { clearInterval(refreshTimer); refreshTimer = null; }
        }

        // ── Retry ────────────────────────────────────────────────────────── //

        $('#btn-retry').on('click', function () {
            Swal.fire({
                title: 'Retry Failed Emails?',
                html: 'This will re-queue all failed emails that haven\'t exceeded the max retry limit.',
                icon: 'warning', showCancelButton: true,
                confirmButtonColor: '#ffc107',
                confirmButtonText: '<i class="fas fa-redo"></i> Yes, Retry',
                cancelButtonText: 'Cancel'
            }).then(function (r) {
                if (!r.isConfirmed) return;
                $.ajax({
                    url: '@Url.Action("Retry", "BulkEmail")',
                    type: 'POST', contentType: 'application/json',
                    data: JSON.stringify({ id: opId }),
                    headers: { 'RequestVerificationToken': getToken() },
                    success: function (resp) {
                        var msg = (resp.result && resp.result.message) ? resp.result.message : resp.message || 'Retry job queued.';
                        toast('success', 'Retry Queued', msg);
                        loadDetail();
                    },
                    error: function (xhr) {
                        var msg = 'An unexpected error occurred.';
                        try { var err = JSON.parse(xhr.responseText); msg = (err.error && err.error.message) ? err.error.message : msg; } catch(_) {}
                        alertError(msg);
                    }
                });
            });
        });

        // ── Templates ────────────────────────────────────────────────────── //

        var templateCache = [];

        function renderTemplatesTable(templates) {
            var $tbody = $('#templates-tbody');
            $tbody.empty();
            if (!templates || templates.length === 0) {
                $('#templates-table').hide();
                $('#no-templates-msg').show();
                $('#tpl-header-hint').text('');
                return;
            }
            $('#no-templates-msg').hide();
            $('#templates-table').show();
            var totalWeight = templates.reduce(function (s, t) { return s + t.weight; }, 0);
            templates.forEach(function (t, i) {
                var chance = totalWeight > 0 ? Math.round((t.weight / totalWeight) * 100) : 0;
                var preview = (t.subject || '').length > 55 ? t.subject.substring(0, 52) + '...' : t.subject;
                $tbody.append('<tr>' +
                    '<td>' + (i + 1) + '</td>' +
                    '<td>' + escapeHtml(t.name || '\u2014') + '</td>' +
                    '<td title="' + escapeHtml(t.subject) + '">' + escapeHtml(preview) + '</td>' +
                    '<td>' + t.weight + '</td>' +
                    '<td><span class="badge badge-info px-2">' + chance + '%</span></td>' +
                    '<td>' +
                        '<button class="btn btn-xs btn-outline-secondary mr-1" onclick="openEditTpl(' + t.id + ')"><i class="fas fa-edit"></i></button>' +
                        '<button class="btn btn-xs btn-outline-danger" onclick="deleteTpl(' + t.id + ')"><i class="fas fa-trash"></i></button>' +
                    '</td>' +
                    '</tr>');
            });
            $('#tpl-header-hint').text('(' + templates.length + ' template' + (templates.length > 1 ? 's' : '') + ')');
        }

        function openAddTpl() {
            $('#tpl-id').val('');
            $('#tpl-name').val('');
            $('#tpl-subject').val('');
            $('#tpl-body').val('');
            $('#tpl-weight').val(1);
            $('#tpl-modal-title').text('Add Template');
            $('#template-modal').modal('show');
        }

        function openEditTpl(id) {
            var t = templateCache.find(function (x) { return x.id === id; });
            if (!t) return;
            $('#tpl-id').val(t.id);
            $('#tpl-name').val(t.name || '');
            $('#tpl-subject').val(t.subject);
            $('#tpl-body').val(t.body);
            $('#tpl-weight').val(t.weight);
            $('#tpl-modal-title').text('Edit Template');
            $('#template-modal').modal('show');
        }

        function saveTpl() {
            var id = parseInt($('#tpl-id').val()) || 0;
            var subject = $('#tpl-subject').val().trim();
            var body = $('#tpl-body').val().trim();
            if (!subject) { alertError('Subject is required.'); return; }
            if (!body) { alertError('Body is required.'); return; }
            var payload = id > 0
                ? { id: id, name: $('#tpl-name').val().trim(), subject: subject, body: body, weight: parseInt($('#tpl-weight').val()) || 1 }
                : { operationId: opId, name: $('#tpl-name').val().trim(), subject: subject, body: body, weight: parseInt($('#tpl-weight').val()) || 1 };
            var url = id > 0 ? '@Url.Action("UpdateTemplate", "BulkEmail")' : '@Url.Action("AddTemplate", "BulkEmail")';
            $('#btn-save-tpl').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');
            $.ajax({
                url: url, type: 'POST', contentType: 'application/json',
                data: JSON.stringify(payload),
                headers: { 'RequestVerificationToken': getToken() },
                success: function () {
                    $('#template-modal').modal('hide');
                    toast('success', id > 0 ? 'Template updated' : 'Template added', '');
                    loadDetail();
                },
                error: function (xhr) {
                    var msg = 'An error occurred.';
                    try { var e = JSON.parse(xhr.responseText); msg = (e.error && e.error.message) ? e.error.message : msg; } catch (_) {}
                    alertError(msg);
                },
                complete: function () {
                    $('#btn-save-tpl').prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Save Template');
                }
            });
        }

        function deleteTpl(id) {
            Swal.fire({
                title: 'Delete Template?', text: 'This template will be permanently removed.',
                icon: 'warning', showCancelButton: true,
                confirmButtonColor: '#dc3545',
                confirmButtonText: '<i class="fas fa-trash"></i> Delete',
                cancelButtonText: 'Cancel'
            }).then(function (r) {
                if (!r.isConfirmed) return;
                $.ajax({
                    url: '@Url.Action("DeleteTemplate", "BulkEmail")', type: 'POST',
                    contentType: 'application/json', data: JSON.stringify({ id: id }),
                    headers: { 'RequestVerificationToken': getToken() },
                    success: function () { toast('success', 'Deleted', 'Template removed.'); loadDetail(); },
                    error: function (xhr) {
                        var msg = 'An error occurred.';
                        try { var e = JSON.parse(xhr.responseText); msg = (e.error && e.error.message) ? e.error.message : msg; } catch (_) {}
                        alertError(msg);
                    }
                });
            });
        }

        $('#btn-add-template').on('click', openAddTpl);
        $('#btn-save-tpl').on('click', saveTpl);

        // ── Init ─────────────────────────────────────────────────────────── //

        initSignalR();
        loadDetail();

    }(jQuery));
    </script>
}
