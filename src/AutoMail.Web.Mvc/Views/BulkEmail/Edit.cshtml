@{
    ViewBag.Title = "Edit Operation";
    Layout = "~/Views/Shared/Layout/_LayoutEmail.cshtml";
    var operationId = (long)ViewBag.OperationId;
}

@section styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" />
    <style>
        .drop-zone {
            border: 2px dashed #6c757d;
            border-radius: 8px;
            padding: 28px 20px;
            text-align: center;
            cursor: pointer;
            transition: background .25s, border-color .25s;
            background: #f8f9fa;
        }
        .drop-zone:hover, .drop-zone.dragover { background: #e9ecef; border-color: #495057; }
        .drop-zone .dz-icon { font-size: 2.5rem; color: #6c757d; }
        .drop-zone .dz-label { font-size: .95rem; color: #555; margin-top: 6px; }
        .drop-zone .dz-hint  { font-size: .8rem; color: #999; margin-top: 3px; }

        #page-overlay {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,.35); z-index: 9999;
            align-items: center; justify-content: center;
        }
        #page-overlay.show { display: flex; }
        .spinner-border-lg { width: 3.5rem; height: 3.5rem; border-width: .4em; }

        .sender-badge-active   { background: #28a745; color: #fff; padding: 2px 10px; border-radius: 12px; font-size: .8rem; }
        .sender-badge-inactive { background: #dc3545; color: #fff; padding: 2px 10px; border-radius: 12px; font-size: .8rem; }
    </style>
}

<div id="page-overlay">
    <div class="spinner-border text-light spinner-border-lg" role="status">
        <span class="sr-only">Loading...</span>
    </div>
</div>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-edit text-warning"></i> Edit Draft #<span id="op-id-label">@operationId</span>
                </h1>
            </div>
            <div class="col-sm-6 text-right">
                <a href="@Url.Action("Index", "BulkEmail")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Operations
                </a>
            </div>
        </div>
    </div>
</div>

<form id="__AntiForgeryForm" style="display:none">@Html.AntiForgeryToken()</form>

<section class="content">
<div class="container-fluid">
<div class="row justify-content-center">
<div class="col-xl-8 col-lg-10 col-12">

    <!-- ═══════════ Recipients ═══════════ -->
    <div class="card card-primary card-outline">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-users mr-1"></i> Recipients</h3>
        </div>
        <div class="card-body">
            <div class="alert alert-info mb-3" id="current-recipients-info">
            </div>
            <div class="border-top pt-3">
                <p class="text-muted small mb-2">Upload a new .xlsx or .csv file to replace all existing recipients. Leave empty to keep current ones.</p>
                <div class="drop-zone" id="drop-zone">
                    <div class="dz-icon"><i class="fas fa-cloud-upload-alt"></i></div>
                    <div class="dz-label">Drop file here or <strong>click to browse</strong></div>
                    <input type="file" id="file-input" accept=".xlsx,.csv" style="display:none" />
                </div>
                <div id="file-name-display" class="mt-2 text-info font-weight-bold" style="display:none"></div>
                <div class="form-group mt-2 mb-0" id="col-index-row" style="display:none">
                    <input type="number" class="form-control" id="email-column-index" value="0" min="0" max="99" style="max-width:160px" />
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════ Compose Message ═══════════ -->
    <div class="card card-success card-outline">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-envelope-open-text mr-1"></i> Compose Message</h3>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label>Subject <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="email-subject" maxlength="500" />
            </div>
            <div class="form-group mb-0">
                <label>Body <span class="text-danger">*</span></label>
                <div id="email-body"></div>
            </div>
        </div>
    </div>

    <!-- ═══════════ AI Settings ═══════════ -->
    <div class="card card-warning card-outline">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-robot mr-1"></i> AI Template Generation</h3>
        </div>
        <div class="card-body">
            <div class="form-group mb-2">
                <label class="mb-1">AI Mode</label>
                <select class="form-control" id="ai-generation-mode" style="max-width:320px">
                    <option value="0">Disabled (Manual templates only)</option>
                    <option value="1">Pre-generate template pool before send</option>
                </select>
                <small class="text-muted">If settings change, previous AI templates are replaced on next start.</small>
            </div>

            <div id="ai-settings-panel" style="display:none">
                <div class="form-row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Variant Count</label>
                            <input type="number" class="form-control" id="ai-variant-count" min="1" max="20" value="3" />
                            <small class="text-muted">Number of AI-generated templates.</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Tone</label>
                            <select class="form-control" id="ai-tone">
                                <option value="">Auto detect</option>
                                <option value="professional">Professional</option>
                                <option value="promotional">Promotional</option>
                                <option value="announcement">Announcement</option>
                                <option value="warm">Warm</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-0">
                    <label>AI Prompt</label>
                    <textarea class="form-control" id="ai-prompt" rows="3" maxlength="4000" placeholder="Optional campaign prompt for AI generation"></textarea>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════ Email Templates ═══════════ -->
    <div class="card card-info card-outline">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-copy mr-1"></i> Email Templates
                <small class="text-muted ml-2" id="tpl-header-hint"></small>
            </h3>
            <div class="card-tools">
                <button type="button" class="btn btn-sm btn-primary" id="btn-add-tpl">
                    <i class="fas fa-plus mr-1"></i> Add Template
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div id="no-tpl-msg" class="text-center text-muted py-3">
                <i class="fas fa-info-circle mr-1"></i>
                No templates &mdash; the default subject &amp; body will be used for all emails.
            </div>
            <table class="table table-sm table-hover mb-0" id="tpl-table" style="display:none">
                <thead class="thead-light">
                    <tr>
                        <th style="width:35px">#</th>
                        <th>Name</th>
                        <th>Subject</th>
                        <th style="width:70px">Weight</th>
                        <th style="width:70px">Chance</th>
                        <th style="width:90px"></th>
                    </tr>
                </thead>
                <tbody id="tpl-tbody"></tbody>
            </table>
        </div>
        <div class="card-footer text-muted small">
            <i class="fas fa-random mr-1"></i> The sending job picks one template per email using weighted random selection.
        </div>
    </div>

    <!-- ═══════════ Email Senders ═══════════ -->
    <div class="card card-secondary card-outline">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-server mr-1"></i> Email Senders</h3>
            <div class="card-tools">
                <button type="button" class="btn btn-primary btn-sm" id="btn-add-sender">
                    <i class="fas fa-plus mr-1"></i> Add Sender
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover table-striped mb-0" id="senders-table">
                <thead class="thead-light">
                    <tr>
                        <th>Email</th>
                        <th>Display Name</th>
                        <th>SMTP Host</th>
                        <th>Daily Limit</th>
                        <th>Delay (ms)</th>
                        <th>Status</th>
                        <th style="width:120px">Actions</th>
                    </tr>
                </thead>
                <tbody id="senders-tbody">
                    <tr><td colspan="7" class="text-center py-3 text-muted"><i class="fas fa-spinner fa-spin mr-1"></i> Loading...</td></tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small" id="sender-summary"></div>
    </div>

    <!-- ═══════════ Actions ═══════════ -->
    <div class="text-center mb-4">
        <button type="button" id="btn-save" class="btn btn-secondary btn-lg mr-2">
            <i class="fas fa-save mr-1"></i> Save Changes
        </button>
        <button type="button" id="btn-save-start" class="btn btn-success btn-lg">
            <i class="fas fa-rocket mr-1"></i> Save &amp; Start
        </button>
        <div class="mt-2">
            <small class="text-muted">Only pending (draft) operations can be edited.</small>
        </div>
    </div>

</div>
</div>
</div>
</section>

<!-- ═══════════ Template Add / Edit Modal ═══════════ -->
<div class="modal fade" id="tpl-modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info">
                <h5 class="modal-title text-white" id="tpl-modal-title">Add Template</h5>
                <button type="button" class="close text-white" data-bs-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="tpl-id">
                <div class="form-group">
                    <label>Name <small class="text-muted">(optional)</small></label>
                    <input type="text" id="tpl-name" class="form-control" placeholder="e.g. Friendly tone, Follow-up A...">
                </div>
                <div class="form-group">
                    <label>Subject <span class="text-danger">*</span></label>
                    <input type="text" id="tpl-subject" class="form-control">
                </div>
                <div class="form-group">
                    <label>Body <span class="text-danger">*</span></label>
                    <div id="tpl-body"></div>
                </div>
                <div class="form-row align-items-center">
                    <div class="col-auto">
                        <label class="mb-0">Weight</label>
                        <input type="number" id="tpl-weight" class="form-control" style="width:90px" value="1" min="1" max="100">
                    </div>
                    <div class="col text-muted small mt-3">Higher weight = selected more often. Equal weights = equal chance.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-info" id="btn-save-tpl">
                    <i class="fas fa-save mr-1"></i> Save Template
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════ Sender Add / Edit Modal ═══════════ -->
<div class="modal fade" id="sender-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="sender-modal-title">Add Email Sender</h5>
                <button type="button" class="close text-white" data-bs-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="sender-id" value="" />
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Email (SMTP username) <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="sender-email" maxlength="256" placeholder="sender@gmail.com" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Password (App Password) <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" id="sender-password" maxlength="512" placeholder="App password" />
                            <small class="text-muted" id="password-hint" style="display:none">Leave blank to keep existing password.</small>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Display Name</label>
                            <input type="text" class="form-control" id="sender-display-name" maxlength="128" placeholder="My Sender Name" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>SMTP Host</label>
                            <input type="text" class="form-control" id="sender-smtp-host" maxlength="256" value="smtp.gmail.com" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>SMTP Port</label>
                            <input type="number" class="form-control" id="sender-smtp-port" value="587" min="1" max="65535" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Enable SSL</label>
                            <select class="form-control" id="sender-enable-ssl">
                                <option value="true" selected>Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Daily Limit</label>
                            <input type="number" class="form-control" id="sender-daily-limit" value="500" min="1" max="10000" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Delay (ms)</label>
                            <input type="number" class="form-control" id="sender-delay" value="1000" min="0" max="60000" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="sender-active" checked />
                        <label class="custom-control-label" for="sender-active">Active</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-save-sender">
                    <i class="fas fa-save mr-1"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
    <script>
    (function ($) {
        'use strict';

        var opId         = @operationId;
        var selectedFile = null;
        var templateCache = [];

        var tplModalEl = document.getElementById('tpl-modal');
        var tplModal   = new bootstrap.Modal(tplModalEl);

        function showLoading()  { $('#page-overlay').addClass('show'); }
        function hideLoading()  { $('#page-overlay').removeClass('show'); }
        function getToken()     { return $('input[name="__RequestVerificationToken"]').val(); }
        function escapeHtml(s)  { return s ? $('<span>').text(s).html() : ''; }
        function getAiMode()    { return parseInt($('#ai-generation-mode').val(), 10) || 0; }

        function toggleAiPanel() {
            var enabled = getAiMode() === 1;
            $('#ai-settings-panel').toggle(enabled);
        }

        function toast(icon, title, text) {
            Swal.fire({ icon: icon, title: title, text: text,
                        toast: true, position: 'top-end',
                        showConfirmButton: false, timer: 3500, timerProgressBar: true });
        }
        function alertError(msg) { Swal.fire({ icon: 'error', title: 'Error', text: msg }); }

        // ── Summernote ───────────────────────────────────────────────────── //

        $('#email-body').summernote({
            height: 250,
            placeholder: 'Compose your email body here...',
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'italic', 'underline', 'strikethrough', 'clear']],
                ['fontname', ['fontname']], ['fontsize', ['fontsize']], ['color', ['color']],
                ['para', ['ul', 'ol', 'paragraph']], ['table', ['table']],
                ['insert', ['link', 'picture', 'hr']], ['view', ['fullscreen', 'codeview', 'undo', 'redo']]
            ]
        });

        // ── File drag-drop ───────────────────────────────────────────────── //

        var dropZone  = $('#drop-zone');
        var fileInput = $('#file-input');

        $(document).on('dragover drop', function (e) { e.preventDefault(); });
        fileInput.on('click', function (e) { e.stopPropagation(); });
        dropZone.on('click', function () { fileInput.trigger('click'); });
        dropZone.on('dragover', function (e) { e.preventDefault(); dropZone.addClass('dragover'); })
                .on('dragleave drop', function () { dropZone.removeClass('dragover'); });
        dropZone.on('drop', function (e) {
            e.preventDefault();
            var files = e.originalEvent.dataTransfer.files;
            if (files.length) { fileInput[0].files = files; onFileSelected(files[0]); }
        });
        fileInput.on('change', function () { if (this.files.length) onFileSelected(this.files[0]); });

        function onFileSelected(file) {
            var ext = file.name.slice(file.name.lastIndexOf('.')).toLowerCase();
            if (!['.xlsx', '.csv'].includes(ext)) {
                alertError('Only .xlsx and .csv files are supported.');
                fileInput.val(''); selectedFile = null; return;
            }
            selectedFile = file;
            $('#file-name-display').text('\uD83D\uDCCE ' + file.name + '  (' + (file.size / 1024).toFixed(1) + ' KB)').show();
            $('#col-index-row').show();
        }

        // ── Load operation data ──────────────────────────────────────────── //

        function loadData() {
            $.ajax({
                url: '@Url.Action("Detail", "BulkEmail")',
                data: { id: opId }, type: 'GET',
                success: function (resp) {
                    var op = resp.result || resp;
                    if ((op.statusText || '').toLowerCase() !== 'pending') {
                        alertError('This operation is no longer a draft and cannot be edited.');
                        setTimeout(function () {
                            window.location.href = '@Url.Action("DetailPage", "BulkEmail")?id=' + opId;
                        }, 2000);
                        return;
                    }
                    $('#email-subject').val(op.subject || '');
                    $('#email-body').summernote('code', op.body || '');
                    $('#ai-generation-mode').val((op.aiGenerationMode || 0).toString());
                    $('#ai-variant-count').val(op.aiVariantCount || 3);
                    $('#ai-prompt').val(op.aiPrompt || '');
                    $('#ai-tone').val(op.aiTone || '');
                    toggleAiPanel();
                    $('#current-recipients-info').html(
                        '<i class="fas fa-users mr-1"></i> Current recipients: <strong>' + op.totalEmails + '</strong> email(s). ' +
                        'Upload a new file below to replace them.');
                    templateCache = op.templates || [];
                    renderTemplatesTable(templateCache);
                },
                error: function () { alertError('Failed to load operation data.'); }
            });
        }

        // ── Templates ────────────────────────────────────────────────────── //

        function renderTemplatesTable(templates) {
            var $tbody = $('#tpl-tbody');
            $tbody.empty();
            if (!templates || !templates.length) {
                $('#tpl-table').hide(); $('#no-tpl-msg').show(); $('#tpl-header-hint').text(''); return;
            }
            $('#no-tpl-msg').hide(); $('#tpl-table').show();
            var totalW = templates.reduce(function (s, t) { return s + t.weight; }, 0);
            templates.forEach(function (t, i) {
                var chance  = totalW > 0 ? Math.round((t.weight / totalW) * 100) : 0;
                var preview = (t.subject || '').length > 55 ? t.subject.substring(0, 52) + '...' : t.subject;
                $tbody.append('<tr>' +
                    '<td>' + (i + 1) + '</td>' +
                    '<td>' + escapeHtml(t.name || '\u2014') + '</td>' +
                    '<td title="' + escapeHtml(t.subject) + '">' + escapeHtml(preview) + '</td>' +
                    '<td>' + t.weight + '</td>' +
                    '<td><span class="badge badge-info px-2">' + chance + '%</span></td>' +
                    '<td>' +
                        '<button class="btn btn-xs btn-outline-secondary mr-1" onclick="openEditTpl(' + t.id + ')"><i class="fas fa-edit"></i></button>' +
                        '<button class="btn btn-xs btn-outline-danger" onclick="deleteTpl(' + t.id + ')"><i class="fas fa-trash"></i></button>' +
                    '</td></tr>');
            });
            $('#tpl-header-hint').text('(' + templates.length + ' template' + (templates.length > 1 ? 's' : '') + ')');
        }

        $('#btn-add-tpl').on('click', function () {
            $('#tpl-id').val(''); $('#tpl-name').val(''); $('#tpl-subject').val(''); $('#tpl-body').val(''); $('#tpl-weight').val(1);
            $('#tpl-modal-title').text('Add Template'); tplModal.show();
        });

        window.openEditTpl = function (id) {
            var t = templateCache.find(function (x) { return x.id === id; });
            if (!t) return;
            $('#tpl-id').val(t.id); $('#tpl-name').val(t.name || ''); $('#tpl-subject').val(t.subject);
            $('#tpl-body').val(t.body); $('#tpl-weight').val(t.weight);
            $('#tpl-modal-title').text('Edit Template'); tplModal.show();
        };

        $('#btn-save-tpl').on('click', function () {
            var id      = parseInt($('#tpl-id').val()) || 0;
            var subject = $('#tpl-subject').val().trim();
            var body    = $('#tpl-body').val().trim();
            if (!subject) { alertError('Subject is required.'); return; }
            if (!body)    { alertError('Body is required.'); return; }
            var payload = id > 0
                ? { id: id, name: $('#tpl-name').val().trim(), subject: subject, body: body, weight: parseInt($('#tpl-weight').val()) || 1 }
                : { operationId: opId, name: $('#tpl-name').val().trim(), subject: subject, body: body, weight: parseInt($('#tpl-weight').val()) || 1 };
            var url = id > 0 ? '@Url.Action("UpdateTemplate", "BulkEmail")' : '@Url.Action("AddTemplate", "BulkEmail")';
            $('#btn-save-tpl').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');
            $.ajax({
                url: url, type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                headers: { 'RequestVerificationToken': getToken() },
                success: function () { tplModal.hide(); toast('success', id > 0 ? 'Template updated' : 'Template added', ''); loadData(); },
                error: function (xhr) {
                    var msg = 'An error occurred.';
                    try { var e = JSON.parse(xhr.responseText); msg = (e.error && e.error.message) ? e.error.message : msg; } catch (_) {}
                    alertError(msg);
                },
                complete: function () { $('#btn-save-tpl').prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Save Template'); }
            });
        });

        window.deleteTpl = function (id) {
            Swal.fire({ title: 'Delete Template?', text: 'This template will be permanently removed.',
                icon: 'warning', showCancelButton: true, confirmButtonColor: '#dc3545',
                confirmButtonText: '<i class="fas fa-trash"></i> Delete'
            }).then(function (r) {
                if (!r.isConfirmed) return;
                $.ajax({
                    url: '@Url.Action("DeleteTemplate", "BulkEmail")', type: 'POST',
                    contentType: 'application/json', data: JSON.stringify({ id: id }),
                    headers: { 'RequestVerificationToken': getToken() },
                    success: function () { toast('success', 'Deleted', 'Template removed.'); loadData(); },
                    error: function (xhr) {
                        var msg = 'An error occurred.';
                        try { var e = JSON.parse(xhr.responseText); msg = (e.error && e.error.message) ? e.error.message : msg; } catch (_) {}
                        alertError(msg);
                    }
                });
            });
        };

        // ── Save / Save & Start ──────────────────────────────────────────── //

        function doSave(startAfter) {
            var subject  = $.trim($('#email-subject').val());
            var body     = $('#email-body').summernote('code');
            var bodyText = $.trim($('<div>').html(body).text());
            var aiMode = getAiMode();
            var aiVariantCount = parseInt($('#ai-variant-count').val(), 10) || 0;
            var aiPrompt = $.trim($('#ai-prompt').val());
            var aiTone = $.trim($('#ai-tone').val());
            if (!subject)  { alertError('Subject is required.'); return; }
            if (!bodyText) { alertError('Body is required.'); return; }
            if (aiMode === 1 && (aiVariantCount < 1 || aiVariantCount > 20)) {
                alertError('AI Variant Count must be between 1 and 20 when AI is enabled.');
                return;
            }

            showLoading();
            var fd = new FormData();
            fd.append('Id', opId);
            fd.append('Subject', subject);
            fd.append('Body', body);
            fd.append('AiGenerationMode', aiMode.toString());
            fd.append('AiVariantCount', aiMode === 1 ? aiVariantCount.toString() : '0');
            fd.append('AiPrompt', aiPrompt);
            fd.append('AiTone', aiTone);
            if (selectedFile) {
                fd.append('File', selectedFile);
                fd.append('EmailColumnIndex', $('#email-column-index').val() || '0');
            }

            $.ajax({
                url: '@Url.Action("UpdateOperation", "BulkEmail")',
                type: 'POST', data: fd, processData: false, contentType: false,
                headers: { 'RequestVerificationToken': getToken() },
                success: function () {
                    if (!startAfter) {
                        hideLoading();
                        toast('success', 'Saved', 'Draft updated successfully.');
                        selectedFile = null;
                        $('#file-name-display').hide();
                        $('#col-index-row').hide();
                        loadData();
                        return;
                    }
                    // Save & Start — now start the job
                    $.ajax({
                        url: '@Url.Action("Start", "BulkEmail")',
                        type: 'POST', contentType: 'application/json',
                        data: JSON.stringify({ id: opId }),
                        headers: { 'RequestVerificationToken': getToken() },
                        success: function () {
                            hideLoading();
                            Swal.fire({ icon: 'success', title: 'Operation Started!',
                                html: 'Draft #' + opId + ' has been started. The sending job is now queued.',
                                confirmButtonColor: '#28a745'
                            }).then(function () { window.location.href = '@Url.Action("Index", "BulkEmail")'; });
                        },
                        error: function (xhr) {
                            hideLoading();
                            var msg = 'Saved but failed to start.';
                            try { var e = JSON.parse(xhr.responseText); msg = (e.error && e.error.message) ? e.error.message : msg; } catch (_) {}
                            alertError(msg);
                        }
                    });
                },
                error: function (xhr) {
                    hideLoading();
                    var msg = 'Failed to save operation.';
                    try { var e = JSON.parse(xhr.responseText); msg = (e.error && e.error.message) ? e.error.message : msg; } catch (_) {}
                    alertError(msg);
                }
            });
        }

        $('#btn-save').on('click', function () { doSave(false); });
        $('#btn-save-start').on('click', function () {
            Swal.fire({
                title: 'Save & Start?',
                text: 'The operation will be saved and the sending job will be queued immediately.',
                icon: 'question', showCancelButton: true,
                confirmButtonColor: '#28a745', confirmButtonText: '<i class="fas fa-rocket"></i> Save & Start'
            }).then(function (r) { if (r.isConfirmed) doSave(true); });
        });

        // ── Sender management ─────────────────────────────────────────────── //

        var senderModalEl = document.getElementById('sender-modal');
        var senderModal   = new bootstrap.Modal(senderModalEl);

        function loadSenders() {
            $.ajax({
                url: '@Url.Action("GetAll", "EmailSender")',
                type: 'GET',
                success: function (resp) {
                    var list   = resp.result || resp;
                    var $tbody = $('#senders-tbody');
                    $tbody.empty();

                    if (!list || !list.length) {
                        $tbody.html('<tr><td colspan="7" class="text-center py-3 text-muted">No senders configured. Click "Add Sender" to get started.</td></tr>');
                        $('#sender-summary').html('<i class="fas fa-exclamation-triangle text-warning mr-1"></i> No active senders — you need at least one to start an operation.');
                        return;
                    }

                    var activeCount    = 0;
                    var totalCapacity  = 0;
                    list.forEach(function (s) {
                        if (s.isActive) { activeCount++; totalCapacity += s.dailyLimit; }
                        var badge = s.isActive
                            ? '<span class="sender-badge-active">Active</span>'
                            : '<span class="sender-badge-inactive">Inactive</span>';
                        $tbody.append(
                            '<tr>' +
                            '<td>' + escapeHtml(s.email) + '</td>' +
                            '<td>' + escapeHtml(s.displayName || '\u2014') + '</td>' +
                            '<td>' + escapeHtml(s.smtpHost) + ':' + s.smtpPort + '</td>' +
                            '<td>' + s.dailyLimit + '</td>' +
                            '<td>' + s.delayBetweenEmailsMs + '</td>' +
                            '<td>' + badge + '</td>' +
                            '<td>' +
                                '<button class="btn btn-sm btn-outline-primary mr-1 btn-edit-sender" data-id="' + s.id + '"><i class="fas fa-edit"></i></button>' +
                                '<button class="btn btn-sm btn-outline-danger btn-delete-sender" data-id="' + s.id + '" data-email="' + escapeHtml(s.email) + '"><i class="fas fa-trash"></i></button>' +
                            '</td>' +
                            '</tr>'
                        );
                    });
                    $('#sender-summary').html('<i class="fas fa-info-circle mr-1"></i>' + activeCount + ' active sender(s), total daily capacity: <strong>' + totalCapacity + '</strong> emails');
                },
                error: function () { alertError('Failed to load senders.'); }
            });
        }

        // ── Add sender ──
        $('#btn-add-sender').on('click', function () {
            $('#sender-modal-title').text('Add Email Sender');
            $('#sender-id').val('');
            $('#sender-email').val('').prop('disabled', false);
            $('#sender-password').val('').attr('placeholder', 'App password');
            $('#password-hint').hide();
            $('#sender-display-name').val('');
            $('#sender-smtp-host').val('smtp.gmail.com');
            $('#sender-smtp-port').val(587);
            $('#sender-enable-ssl').val('true');
            $('#sender-daily-limit').val(500);
            $('#sender-delay').val(1000);
            $('#sender-active').prop('checked', true);
            senderModal.show();
        });

        // ── Edit sender ──
        $(document).on('click', '.btn-edit-sender', function () {
            var id = $(this).data('id');
            $.ajax({
                url: '@Url.Action("Get", "EmailSender")',
                data: { id: id }, type: 'GET',
                success: function (resp) {
                    var s = resp.result || resp;
                    $('#sender-modal-title').text('Edit Email Sender');
                    $('#sender-id').val(s.id);
                    $('#sender-email').val(s.email).prop('disabled', false);
                    $('#sender-password').val('').attr('placeholder', 'Leave blank to keep existing');
                    $('#password-hint').show();
                    $('#sender-display-name').val(s.displayName || '');
                    $('#sender-smtp-host').val(s.smtpHost);
                    $('#sender-smtp-port').val(s.smtpPort);
                    $('#sender-enable-ssl').val(s.enableSsl ? 'true' : 'false');
                    $('#sender-daily-limit').val(s.dailyLimit);
                    $('#sender-delay').val(s.delayBetweenEmailsMs);
                    $('#sender-active').prop('checked', s.isActive);
                    senderModal.show();
                },
                error: function () { alertError('Failed to load sender details.'); }
            });
        });

        // ── Save sender (Create / Update) ──
        $('#btn-save-sender').on('click', function () {
            var id     = $('#sender-id').val();
            var isEdit = !!id;
            var payload = {
                email:                $.trim($('#sender-email').val()),
                password:             $.trim($('#sender-password').val()),
                displayName:          $.trim($('#sender-display-name').val()),
                smtpHost:             $.trim($('#sender-smtp-host').val()),
                smtpPort:             parseInt($('#sender-smtp-port').val(), 10),
                enableSsl:            $('#sender-enable-ssl').val() === 'true',
                isActive:             $('#sender-active').is(':checked'),
                dailyLimit:           parseInt($('#sender-daily-limit').val(), 10),
                delayBetweenEmailsMs: parseInt($('#sender-delay').val(), 10)
            };
            if (!payload.email) { alertError('Email is required.'); return; }
            if (!isEdit && !payload.password) { alertError('Password is required for new senders.'); return; }
            if (isEdit) payload.id = parseInt(id, 10);

            var url = isEdit ? '@Url.Action("Update", "EmailSender")' : '@Url.Action("Create", "EmailSender")';
            $('#btn-save-sender').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');
            $.ajax({
                url: url, type: 'POST', contentType: 'application/json',
                data: JSON.stringify(payload),
                headers: { 'RequestVerificationToken': getToken() },
                success: function () {
                    senderModal.hide();
                    toast('success', 'Saved', 'Sender ' + (isEdit ? 'updated' : 'created') + ' successfully.');
                    loadSenders();
                },
                error: function (xhr) {
                    var msg = 'Failed to save sender.';
                    try { var e = JSON.parse(xhr.responseText); msg = (e.error && e.error.message) ? e.error.message : msg; } catch (_) {}
                    alertError(msg);
                },
                complete: function () { $('#btn-save-sender').prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Save'); }
            });
        });

        // ── Delete sender ──
        $(document).on('click', '.btn-delete-sender', function () {
            var id    = $(this).data('id');
            var email = $(this).data('email');
            Swal.fire({
                title: 'Delete Sender?',
                html: 'Are you sure you want to delete <strong>' + escapeHtml(email) + '</strong>?',
                icon: 'warning', showCancelButton: true,
                confirmButtonColor: '#dc3545', confirmButtonText: 'Yes, delete'
            }).then(function (result) {
                if (!result.isConfirmed) return;
                $.ajax({
                    url: '@Url.Action("Delete", "EmailSender")', type: 'POST',
                    contentType: 'application/json', data: JSON.stringify({ id: id }),
                    headers: { 'RequestVerificationToken': getToken() },
                    success: function () {
                        toast('success', 'Deleted', 'Sender removed successfully.');
                        loadSenders();
                    },
                    error: function () { alertError('Failed to delete sender.'); }
                });
            });
        });

        // ── Init ─────────────────────────────────────────────────────────── //

        loadData();
        loadSenders();
        $('#ai-generation-mode').on('change', toggleAiPanel);
        toggleAiPanel();

    }(jQuery));
    </script>
}
